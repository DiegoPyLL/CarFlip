---
// Identificación del responsable del sitio y del tratamiento de datos. Idéntica
// en /legal y /privacidad, por eso vive acá: un cambio de domicilio o de correo
// es un solo edit y los dos documentos no pueden contradecirse.
//
// Se publica comuna y región, no calle y número: la ley exige un domicilio, no
// que la dirección particular de una persona natural quede indexada. El
// domicilio completo se entrega a requerimiento, y así lo dice /privacidad.
import { enlaceCls } from '@lib/legal';
