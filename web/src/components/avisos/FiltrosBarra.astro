---
// Barra superior del listado: expone el mismo set primario que el buscador de
// la portada, para que filtrar signifique lo mismo en ambas pantallas.
import BotonBuscar from '@components/filtros/BotonBuscar.astro';
import CampoRegion from '@components/filtros/CampoRegion.astro';
import CampoTraccion from '@components/filtros/CampoTraccion.astro';
import CampoTransmision from '@components/filtros/CampoTransmision.astro';
import { labelCls, selectCls } from '@components/filtros/estilos';
import type { FiltrosAviso, FiltrosDisponibles } from '@lib/tipos';

interface Props {
  filtros: FiltrosAviso;
  disponibles: FiltrosDisponibles;
}

const { filtros, disponibles } = Astro.props;
---

<!--
  A 16px los selects no caben en una sola fila: se apila en bloques, igual que
  los filtros de /deals.
-->
<div class="bg-accent bloque-acento p-element mb-block space-y-element">

  <div class="grid gap-element sm:grid-cols-2 lg:grid-cols-4">
    <!-- Marca -->
    <div>
      <label for="marca" class={labelCls}>Marca</label>
      <select id="marca" name="marca" class={selectCls}>
        <option value="">Todas</option>
        {disponibles.marcas.map((m) => (
          <option value={m} selected={filtros.marca === m}>{m}</option>
        ))}
      </select>
    </div>

    <!-- Año -->
    <div>
      <label for="anio" class={labelCls}>Año</label>
      <select id="anio" name="anio" class={selectCls}>
        <option value="">Todos</option>
        {disponibles.anios.map((a) => (
          <option value={a} selected={filtros.anio === a}>{a}</option>
        ))}
      </select>
    </div>

    <CampoRegion valor={filtros.region} />

    <CampoTransmision valor={filtros.transmision} />
  </div>

  <div class="flex flex-wrap items-end justify-between gap-element">
    <CampoTraccion valor={filtros.traccion} />

    <!-- Acciones: sin relleno de color, pero con borde y target táctil suficiente -->
    <div class="flex items-end gap-element ml-auto">
      <BotonBuscar />
      <a href="/avisos" class="text-base text-ink-on-accent hover:underline underline-offset-4 py-2">
        Limpiar
      </a>
    </div>
  </div>
</div>
