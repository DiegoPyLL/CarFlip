---
import type { FiltrosAviso, FiltrosDisponibles } from '@lib/tipos';

interface Props {
  filtros: FiltrosAviso;
  disponibles: FiltrosDisponibles;
}

const { filtros, disponibles } = Astro.props;

const fuentes = [
  { value: '', label: 'Todas' },
  { value: 'autocosmos', label: 'Autocosmos' },
  { value: 'yapo', label: 'Yapo' },
  { value: 'autosusados', label: 'AutosUsados' },
  { value: 'checkeados', label: 'Checkeados' },
];

const selectCls = [
  'text-base bg-canvas border border-line-strong px-3 py-2',
  'text-ink appearance-none cursor-pointer',
  'focus:outline-hidden focus:border-scarlet-signal',
  'transition-colors',
].join(' ');

const labelCls = 'text-sm  uppercase tracking-wider';
---

<!--
  A 16px las cinco fuentes más los dos selects no caben en una sola fila:
  se apila en dos bloques, igual que los filtros de /deals.
-->
<div class="pb-block mb-block border-b border-line space-y-element">

  <!-- Fuente: toggle buttons -->
  <fieldset>
    <legend class={`${labelCls} mb-2`}>Fuente</legend>
    <div class="flex flex-wrap gap-2">
      {fuentes.map(({ value, label }) => (
        <label class="cursor-pointer select-none">
          <input
            type="radio"
            name="fuente"
            value={value}
            class="sr-only peer"
            checked={filtros.fuente === value || (!filtros.fuente && value === '')}
          />
          <span class="block px-3 py-2 text-base border border-line-strong  peer-checked:bg-ink peer-checked:text-canvas peer-checked:border-ink peer-focus-visible:border-scarlet-signal hover:border-ink hover:text-ink transition-colors whitespace-nowrap">
            {label}
          </span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="flex flex-wrap items-end gap-element">

    <!-- Marca -->
    <div class="flex flex-col gap-2">
      <label for="marca" class={labelCls}>Marca</label>
      <select id="marca" name="marca" class={selectCls}>
        <option value="">Todas</option>
        {disponibles.marcas.map((m) => (
          <option value={m} selected={filtros.marca === m}>{m}</option>
        ))}
      </select>
    </div>

    <!-- Año -->
    <div class="flex flex-col gap-2">
      <label for="anio" class={labelCls}>Año</label>
      <select id="anio" name="anio" class={selectCls}>
        <option value="">Todos</option>
        {disponibles.anios.map((a) => (
          <option value={a} selected={filtros.anio === a}>{a}</option>
        ))}
      </select>
    </div>

    <!-- Acciones: sin relleno de color, pero con borde y target táctil suficiente -->
    <div class="flex items-end gap-element ml-auto">
      <button
        type="submit"
        class="inline-flex items-center gap-2 text-base text-ink border border-ink px-5 py-2 hover:bg-ink hover:text-canvas focus:outline-hidden focus:border-scarlet-signal transition-colors duration-150"
      >
        <span class="w-1.5 h-1.5 bg-scarlet-signal shrink-0" aria-hidden="true"></span>
        Filtrar
      </button>
      <a
        href="/avisos"
        class="text-base  hover:text-ink transition-colors py-2"
      >
        Limpiar
      </a>
    </div>
  </div>
</div>
