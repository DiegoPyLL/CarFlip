---
// Barra superior del listado: expone el mismo set primario que el buscador de
// la portada, para que filtrar signifique lo mismo en ambas pantallas.
import BotonBuscar from '@components/filtros/BotonBuscar.astro';
import CampoRegion from '@components/filtros/CampoRegion.astro';
import CampoTraccion from '@components/filtros/CampoTraccion.astro';
import CampoTransmision from '@components/filtros/CampoTransmision.astro';
import { chipCls, labelCls, selectCls } from '@components/filtros/estilos';
import { FUENTES } from '@lib/db/fuentes';
import type { Aviso, FiltrosAviso, FiltrosDisponibles } from '@lib/tipos';

interface Props {
  filtros: FiltrosAviso;
  disponibles: FiltrosDisponibles;
}

const { filtros, disponibles } = Astro.props;

// Los nombres visibles de las fuentes; las claves salen de TABLA_POR_FUENTE, así
// que una fuente nueva aparece sola en el filtro en vez de faltar en silencio.
const ETIQUETA_FUENTE: Record<Aviso['fuente'], string> = {
  autocosmos: 'Autocosmos',
  yapo: 'Yapo',
  autosusados: 'AutosUsados',
  checkeados: 'Checkeados',
  particular: 'Particulares',
};

const fuentes = [
  { value: '', label: 'Todas' },
  ...FUENTES.map((f) => ({ value: f, label: ETIQUETA_FUENTE[f] })),
];
---

<!--
  A 16px las seis opciones de fuente más los selects no caben en una sola fila:
  se apila en bloques, igual que los filtros de /deals.
-->
<div class="pb-block mb-block border-b border-line space-y-element">

  <!-- Fuente: toggle buttons -->
  <fieldset>
    <legend class={labelCls}>Fuente</legend>
    <div class="flex flex-wrap gap-2">
      {fuentes.map(({ value, label }) => (
        <label class="cursor-pointer select-none">
          <input
            type="radio"
            name="fuente"
            value={value}
            class="sr-only peer"
            checked={filtros.fuente === value || (!filtros.fuente && value === '')}
          />
          <span class={chipCls}>{label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="grid gap-element sm:grid-cols-2 lg:grid-cols-4">
    <!-- Marca -->
    <div>
      <label for="marca" class={labelCls}>Marca</label>
      <select id="marca" name="marca" class={selectCls}>
        <option value="">Todas</option>
        {disponibles.marcas.map((m) => (
          <option value={m} selected={filtros.marca === m}>{m}</option>
        ))}
      </select>
    </div>

    <!-- Año -->
    <div>
      <label for="anio" class={labelCls}>Año</label>
      <select id="anio" name="anio" class={selectCls}>
        <option value="">Todos</option>
        {disponibles.anios.map((a) => (
          <option value={a} selected={filtros.anio === a}>{a}</option>
        ))}
      </select>
    </div>

    <CampoRegion valor={filtros.region} />

    <CampoTransmision valor={filtros.transmision} />
  </div>

  <div class="flex flex-wrap items-end justify-between gap-element">
    <CampoTraccion valor={filtros.traccion} />

    <!-- Acciones: sin relleno de color, pero con borde y target táctil suficiente -->
    <div class="flex items-end gap-element ml-auto">
      <BotonBuscar />
      <a href="/avisos" class="text-base hover:text-ink transition-colors py-2">
        Limpiar
      </a>
    </div>
  </div>
</div>
