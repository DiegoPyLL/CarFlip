---
import { formatearPatente } from '@lib/patente';

interface Props {
  /** Canónica: mayúsculas, sin separadores (GSBB20, AA1000, BJH61, AA123). */
  patente: string;
}

const { patente } = Astro.props;

const letras = patente.match(/^[A-Z]+/)?.[0] ?? '';
const digitos = patente.slice(letras.length);
const esAuto = patente.length === 6;

// Grupos visuales de la placa física: los autos estampan pares (GS·BB·20,
// AA·10·00); las motos separan letras de dígitos (BJH·61). En autos, el
// separador del límite letras→dígitos es el sello de seguridad; el resto son
// puntos.
const grupos = esAuto ? patente.match(/.{2}/g)! : [letras, digitos];
const posicionSello = letras.length / 2;
---

<!-- Réplica de la placa patente chilena vigente: blanca, caracteres negros en
     FE-Schrift (la tipografía anti-falsificación que Chile adoptó en 2014),
     proporción 360:130 en autos y «CHILE» al pie; las motos son más compactas
     y llevan «CHILE» arriba. Colores fijos en ambos temas y esquinas
     redondeadas porque imita un objeto físico, no es chrome del producto
     (misma lógica que --c-github; excepción documentada en DESIGN.md). -->
<div class={`patente ${esAuto ? 'patente-auto' : 'patente-moto'}`} role="img" aria-label={`Patente ${formatearPatente(patente)}`}>
  {!esAuto && <span class="pais" aria-hidden="true">CHILE</span>}
  <span class="caracteres" aria-hidden="true">
    {grupos.map((grupo, i) => (
      <>
        {i > 0 &&
          (esAuto && i === posicionSello ? (
            <svg class="sello" viewBox="-12 -12 24 24" fill="currentColor">
              <ellipse rx="3.2" ry="6.5" cy="-5.5" />
              <ellipse rx="3.2" ry="6.5" cy="-5.5" transform="rotate(60)" />
              <ellipse rx="3.2" ry="6.5" cy="-5.5" transform="rotate(120)" />
              <ellipse rx="3.2" ry="6.5" cy="-5.5" transform="rotate(180)" />
              <ellipse rx="3.2" ry="6.5" cy="-5.5" transform="rotate(240)" />
              <ellipse rx="3.2" ry="6.5" cy="-5.5" transform="rotate(300)" />
              <circle r="2.4" fill="#fff" />
            </svg>
          ) : (
            <span class="punto"></span>
          ))}
        <span>{grupo}</span>
      </>
    ))}
  </span>
  {esAuto && <span class="pais" aria-hidden="true">CHILE</span>}
</div>

<style>
  /* Subset A–Z 0–9 (3,8 KB) de la digitalización freeware de FE-Schrift, cuyo
     diseño es obra oficial alemana de dominio público. Solo se descarga en las
     páginas que pintan una placa. */
  @font-face {
    font-family: 'FE-Schrift';
    src: url('/fonts/fe-schrift.woff2') format('woff2');
    font-display: swap;
  }

  .patente {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    background: #fff;
    color: #000;
    border: 3px solid #000;
    border-radius: 8px;
    padding: 0 0.5rem;
  }

  .patente-auto {
    width: 15rem;
    aspect-ratio: 360 / 130;
  }

  .patente-moto {
    width: 8.75rem;
    aspect-ratio: 11 / 8;
    border-width: 2px;
    border-radius: 6px;
  }

  .caracteres {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'FE-Schrift', 'Arial Narrow', sans-serif;
    line-height: 1;
    white-space: nowrap;
  }

  .patente-auto .caracteres {
    font-size: 3rem;
  }

  .patente-moto .caracteres {
    font-size: 2.25rem;
  }

  .punto {
    width: 0.375rem;
    height: 0.375rem;
    background: #000;
    border-radius: 50%;
  }

  .patente-moto .punto {
    width: 0.3125rem;
    height: 0.3125rem;
  }

  .sello {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* El tracking desplaza el texto: el padding-left lo recentra. */
  .pais {
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.5em;
    padding-left: 0.5em;
    line-height: 1;
  }
</style>
