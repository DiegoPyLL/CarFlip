---
import IconoTraccion from '@components/filtros/IconoTraccion.astro';
import type { Aviso } from '@lib/tipos';
import { resolverUrlImagen } from '@lib/cdn';
import { enlaceAviso } from '@lib/enlaces';
import { formatearPrecio, formatearKm, signosDelta } from '@lib/formato';

interface Props {
  aviso: Aviso;
}

const { aviso } = Astro.props;
const urlImagen = resolverUrlImagen(aviso.url_imagen);
const delta = signosDelta(aviso.delta_pct);

const fuenteLabels: Record<string, string> = {
  autocosmos: 'Autocosmos',
  yapo: 'Yapo',
  autosusados: 'Autosusados',
  checkeados: 'Checkeados',
  particular: 'Particular',
};
const fuenteLabel = fuenteLabels[aviso.fuente] || aviso.fuente.toUpperCase();

const metaItems = [
  aviso.anio ? String(aviso.anio) : null,
  formatearKm(aviso.km) !== '—' ? formatearKm(aviso.km) : null,
  aviso.ubicacion ?? null,
].filter(Boolean);
---

<!-- La foto es el borde de la card: sin radio, sin sombra, sin transformaciones. -->
<article class="group border border-line hover:border-ink transition-colors duration-200">
  <!-- `data-card-link` es el punto de anclaje de la vista lista de /avisos, que
       acuesta la tarjeta desde CSS (foto | contenido). -->
  <a
    href={enlaceAviso(aviso, Astro.url.pathname + Astro.url.search)}
    aria-label={`Ver ${aviso.titulo}`}
    class="block"
    data-card-link
  >
    <!-- Imagen -->
    <div class="aspect-[4/3] bg-surface relative">
      {urlImagen ? (
        <img
          src={urlImagen}
          alt={aviso.titulo}
          width={400}
          height={300}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <span class=" text-base">Sin imagen</span>
        </div>
      )}

      <!-- Badges sobre la imagen -->
      <div class="absolute top-element left-element flex flex-wrap gap-2">
        <span data-fuente="badge" class="text-sm px-2 py-0.5 bg-canvas/75 ">
          {fuenteLabel}
        </span>
        {delta && (
          <span class={`text-sm px-2 py-0.5 tabular-nums ${delta.clases}`}>
            {delta.texto}
          </span>
        )}
        {aviso.disponible === false && (
          <span class="text-sm px-2 py-0.5 bg-canvas/75  line-through">
            No disponible
          </span>
        )}
      </div>
    </div>

    <!-- Contenido -->
    <div class="p-element">
      <h2 class="text-base  line-clamp-2 leading-snug mb-3">
        {aviso.titulo}
      </h2>

      <p class="text-2xl mb-2 tabular-nums">
        {aviso.precio
          ? <span class="text-ink">{formatearPrecio(aviso.precio, aviso.moneda)}</span>
          : <span class=" text-base">Precio a consultar</span>
        }
      </p>

      {(metaItems.length > 0 || aviso.traccion) && (
        <p class="text-base flex items-center gap-2 min-w-0">
          {metaItems.length > 0 && <span class="truncate">{metaItems.join(' · ')}</span>}
          {aviso.traccion && (
            <span class="inline-flex items-center gap-1 shrink-0">
              <IconoTraccion traccion={aviso.traccion} />
              {aviso.traccion}
            </span>
          )}
        </p>
      )}
    </div>

    <!-- La misma procedencia, al costado: la fila de la vista lista tiene ancho
         de sobra a la derecha y ahí se lee mejor que encima de la foto. Solo una
         de las dos se muestra a la vez (ver el CSS de /avisos). -->
    <p data-fuente="lado" class="hidden text-sm uppercase tracking-wider pr-element whitespace-nowrap">
      {fuenteLabel}
    </p>
  </a>
</article>
