---
import type { FiltrosAviso, FiltrosDisponibles } from '@lib/tipos';

interface Props {
  filtros: FiltrosAviso;
  disponibles: FiltrosDisponibles;
}

const { filtros, disponibles } = Astro.props;

const inputCls = [
  'w-full text-base',
  'bg-canvas border border-line-strong px-3 py-2',
  'text-ink placeholder-muted',
  'focus:outline-hidden focus:border-scarlet-signal',
  'transition-colors',
].join(' ');

const selectCls = [
  'w-full text-base',
  'bg-canvas border border-line-strong px-3 py-2',
  'text-ink appearance-none cursor-pointer',
  'focus:outline-hidden focus:border-scarlet-signal',
  'transition-colors',
].join(' ');

const labelCls = 'text-sm  uppercase tracking-wider block mb-1';

const hayFiltrosAvanzados = !!(
  filtros.modelo ||
  filtros.combustible ||
  filtros.km_max ||
  filtros.precio_min ||
  filtros.precio_max
);
---

<!-- Botón toggle (solo visible en mobile) -->
<div class="lg:hidden mb-3">
  <button
    type="button"
    id="sidebar-toggle"
    class="flex items-center gap-2 text-base  hover:text-ink transition-colors py-2"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 6h18M7 12h10M10 18h4"/>
    </svg>
    <span id="toggle-label">
      {hayFiltrosAvanzados ? 'Filtros avanzados activos' : 'Más filtros'}
    </span>
    {hayFiltrosAvanzados && (
      <span class="w-1.5 h-1.5 bg-scarlet-signal shrink-0" />
    )}
  </button>
</div>

<!--
  Panel: hidden en mobile por defecto, siempre visible en desktop (lg:block).
  Un único set de inputs → sin duplicados al submitear el form.
-->
<aside
  id="filtros-sidebar"
  class="hidden lg:block w-full lg:w-48 lg:shrink-0 lg:sticky lg:top-20 lg:self-start"
>
  <div class="border border-line p-element space-y-element">
    <p class="text-sm  uppercase tracking-wider hidden lg:block">
      Filtros avanzados
    </p>

    <!-- Buscar (titulo + marca + modelo) -->
    <div>
      <label for="modelo" class={labelCls}>Buscar</label>
      <input
        id="modelo"
        type="text"
        name="modelo"
        value={filtros.modelo ?? ''}
        placeholder="Jeep, Corolla, Civic…"
        maxlength="100"
        class={inputCls}
      />
    </div>

    <!-- Combustible -->
    <div>
      <label for="combustible" class={labelCls}>Combustible</label>
      <select id="combustible" name="combustible" class={selectCls}>
        <option value="">Todos</option>
        {disponibles.combustibles.map((c) => (
          <option value={c} selected={filtros.combustible === c}>{c}</option>
        ))}
      </select>
    </div>

    <!-- Km máximo -->
    <div>
      <label for="km_max" class={labelCls}>Km máximo</label>
      <input
        id="km_max"
        type="number"
        name="km_max"
        min="0"
        step="any"
        value={filtros.km_max ?? ''}
        placeholder="Sin límite"
        aria-describedby="err-km-max"
        class={`${inputCls} campo`}
      />
      <p id="err-km-max" class="campo-error text-sm text-scarlet-signal mt-1.5">
        Ingresa un kilometraje en números, sin negativos.
      </p>
    </div>

    <!-- Precio mínimo -->
    <div>
      <label for="precio_min" class={labelCls}>Precio mínimo</label>
      <input
        id="precio_min"
        type="number"
        name="precio_min"
        min="0"
        step="any"
        value={filtros.precio_min ?? ''}
        placeholder="$ 0"
        aria-describedby="err-precio-min"
        class={`${inputCls} campo`}
      />
      <p id="err-precio-min" class="campo-error text-sm text-scarlet-signal mt-1.5">
        Ingresa un monto en números, sin negativos.
      </p>
    </div>

    <!-- Precio máximo -->
    <div>
      <label for="precio_max" class={labelCls}>Precio máximo</label>
      <input
        id="precio_max"
        type="number"
        name="precio_max"
        min="0"
        step="any"
        value={filtros.precio_max ?? ''}
        placeholder="Sin límite"
        aria-describedby="err-precio-max"
        class={`${inputCls} campo`}
      />
      <p id="err-precio-max" class="campo-error text-sm text-scarlet-signal mt-1.5">
        Ingresa un monto en números, sin negativos.
      </p>
    </div>

    <button
      type="submit"
      class="w-full border border-line-strong text-ink text-base py-2 hover:border-ink hover:bg-ink hover:text-canvas focus:outline-hidden focus:border-scarlet-signal transition-colors mt-1"
    >
      Aplicar filtros
    </button>
  </div>
</aside>

<script>
  const btn   = document.getElementById('sidebar-toggle');
  const panel = document.getElementById('filtros-sidebar');
  const label = document.getElementById('toggle-label');

  btn?.addEventListener('click', () => {
    const hidden = panel?.classList.contains('hidden') ?? true;
    panel?.classList.toggle('hidden', !hidden);
    if (label) label.textContent = hidden ? 'Ocultar filtros' : 'Más filtros';
  });
</script>
