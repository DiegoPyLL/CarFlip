---
import { TRANSMISIONES } from '@lib/publicaciones/opciones';

import { labelCls, selectCls } from './estilos';

interface Props {
  valor?: string;
  id?: string;
}

const { valor, id = 'transmision' } = Astro.props;
---

<div>
  <label for={id} class={labelCls}>Transmisión</label>
  <select id={id} name="transmision" class={selectCls}>
    <option value="">Todas</option>
    {TRANSMISIONES.map((t) => <option value={t} selected={valor === t}>{t}</option>)}
  </select>
</div>
