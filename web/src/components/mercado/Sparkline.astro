---
// Mini-gráfico de línea + área para las tiras de KPI. SVG inline, cero JS.
// `preserveAspectRatio="none"` deja que la caja escale libre; el trazo se
// mantiene fino con `vector-effect="non-scaling-stroke"`.
interface Props {
  valores: number[];
  class?: string;
}
const { valores, class: clase = '' } = Astro.props;

const W = 100;
const H = 30;
const n = valores.length;
const max = Math.max(...valores, 1);
const min = Math.min(...valores, 0);
const rango = max - min || 1;

const coords = valores.map((v, i) => {
  const x = n > 1 ? (i / (n - 1)) * W : W / 2;
  const y = H - ((v - min) / rango) * H;
  return `${x.toFixed(2)},${y.toFixed(2)}`;
});
const linea = coords.join(' ');
const area = `0,${H} ${linea} ${W},${H}`;
---
{n > 1 && (
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    class:list={['block', clase]}
    role="img"
    aria-hidden="true"
  >
    <polygon points={area} class="fill-viz-1/15" />
    <polyline
      points={linea}
      fill="none"
      class="stroke-viz-1"
      stroke-width="1.5"
      stroke-linejoin="round"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>
)}
