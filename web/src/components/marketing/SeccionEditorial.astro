---
// Sección de las páginas de marketing. Desde lg el rubro se descuelga a un
// margen izquierdo fijo y el cuerpo queda en su medida de lectura (64ch); bajo
// lg vuelve a una sola columna con el rubro encima, como el resto del sitio.
//
// `class` deja el ritmo vertical en el call site: por defecto el salto de
// sección, y se sobreescribe donde el relato pide juntar o separar bloques.
import { seccionCls, rubroCls, gridEditorialCls } from '@lib/marketing';

interface Props {
  rubro: string;
  class?: string;
}

const { rubro, class: clase = seccionCls } = Astro.props;
---

<section class={`${clase} ${gridEditorialCls}`}>
  <h2 class={`${rubroCls} lg:mb-0`}>{rubro}</h2>
  <div><slot /></div>
</section>
