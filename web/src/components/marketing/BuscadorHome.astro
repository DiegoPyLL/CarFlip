---
// Buscador de la portada. No filtra nada por sí mismo: es un form GET hacia
// /avisos cuyos `name` son exactamente los que valida `parsearFiltrosUrl`, así
// que el listado recibe, sanea y aplica los parámetros sin lógica nueva.
//
// Expone el mismo set primario de campos que la barra de /avisos y que /deals;
// los controles salen de components/filtros para que los tres se vean y se
// comporten igual.
//
// El campo de texto viaja como `modelo`, que en la capa de datos hace OR sobre
// titulo/marca/modelo y además pasa por `normalizarBusqueda` ("peugot" → "Peugeot").
import BotonBuscar from '@components/filtros/BotonBuscar.astro';
import CampoNumero from '@components/filtros/CampoNumero.astro';
import CampoRegion from '@components/filtros/CampoRegion.astro';
import CampoTraccion from '@components/filtros/CampoTraccion.astro';
import CampoTransmision from '@components/filtros/CampoTransmision.astro';
import { inputCls, labelCls, selectCls } from '@components/filtros/estilos';
import type { FiltrosDisponibles } from '@lib/tipos';

interface Props {
  disponibles: FiltrosDisponibles;
}

const { disponibles } = Astro.props;

// Tope del campo año. `parsearFiltrosUrl` acepta hasta el año siguiente, pero
// acá no tiene sentido ofrecer más que el actual.
const anioMax = new Date().getFullYear();
---

<form
  method="GET"
  action="/avisos"
  id="buscador-home"
  role="search"
  aria-label="Buscar vehículos"
  data-limpiar-vacios
  class="bg-accent bloque-acento p-element space-y-element"
>
  <div class="grid gap-element sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <label for="q" class={labelCls}>Buscar</label>
      <input
        id="q"
        type="text"
        name="modelo"
        placeholder="Corolla, Jeep, Sail…"
        maxlength="100"
        autocomplete="off"
        data-normaliza="texto"
        class={inputCls}
      />
    </div>

    <div>
      <label for="q-marca" class={labelCls}>Marca</label>
      <select id="q-marca" name="marca" class={selectCls}>
        <option value="">Todas</option>
        {disponibles.marcas.map((m) => <option value={m}>{m}</option>)}
      </select>
    </div>

    <CampoRegion id="q-region" />

    <CampoTransmision id="q-transmision" />

    <div>
      <label for="q-anio" class={labelCls}>Año</label>
      <input
        id="q-anio"
        type="number"
        name="anio"
        inputmode="numeric"
        min="1950"
        max={anioMax}
        placeholder="2020"
        data-normaliza="anio"
        aria-describedby="q-anio-error"
        class={`${inputCls} campo tabular-nums`}
      />
      <p id="q-anio-error" class="campo-error text-sm text-scarlet-signal mt-1.5">
        Ingresa un año entre 1950 y {anioMax}.
      </p>
    </div>

    <CampoNumero tipo="precio" nombre="precio_max" etiqueta="Precio máximo" placeholder="$10.000.000" />
  </div>

  <!-- Los chips de tracción necesitan una fila propia: cuatro con icono no
       caben en una celda de la grilla sin desbordar en pantallas medianas. -->
  <div class="flex flex-wrap items-end justify-between gap-element">
    <CampoTraccion />
    <BotonBuscar class="ml-auto" />
  </div>
</form>
