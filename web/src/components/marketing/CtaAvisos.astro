---
// CTA de cierre de las páginas de marketing.
interface Props {
  texto?: string;
}

const { texto = 'Ver todos los avisos disponibles ahora' } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-element">
  <p class="text-base ">{texto}</p>
  <a
    href="/avisos"
    class="inline-flex items-center gap-2 text-base text-ink border border-ink px-6 py-3 hover:bg-ink hover:text-canvas transition-colors duration-150"
  >
    <span aria-hidden="true">→</span>
    Ver avisos
  </a>
</div>
