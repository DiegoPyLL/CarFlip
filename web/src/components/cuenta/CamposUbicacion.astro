---
/**
 * Región y comuna, el par que comparten el perfil y el formulario de aviso.
 *
 * El HTML trae las 346 comunas agrupadas por región: así el formulario funciona
 * sin JavaScript. El script de abajo deja a la vista solo el grupo de la región
 * elegida, que es lo que evita recorrer el país entero para encontrar Ñuñoa.
 */
import { COMUNAS_POR_REGION, REGIONES } from '@lib/publicaciones/opciones';
import { campoCls, errorCls, labelCls, requeridoCls } from '@lib/ui';

interface Props {
  region?: string;
  comuna?: string;
}

const { region, comuna } = Astro.props;
---

<div>
  <label for="region" class={labelCls}>Región <span class={requeridoCls}>*Requerido</span></label>
  <select id="region" name="region" required class={`${campoCls} campo`} aria-describedby="err-region">
    <option value="">Selecciona…</option>
    {REGIONES.map((r) => <option value={r} selected={region === r}>{r}</option>)}
  </select>
  <p id="err-region" class={errorCls}>Selecciona la región.</p>
</div>

<div>
  <label for="comuna" class={labelCls}>Comuna <span class={requeridoCls}>*Requerido</span></label>
  <select
    id="comuna"
    name="comuna"
    required
    data-grupos-de="region"
    class={`${campoCls} campo disabled:opacity-50`}
    aria-describedby="err-comuna"
  >
    <option value="">Selecciona…</option>
    {
      REGIONES.map((r) => (
        <optgroup label={r}>
          {COMUNAS_POR_REGION[r].map((c) => (
            <option value={c} selected={comuna === c}>
              {c}
            </option>
          ))}
        </optgroup>
      ))
    }
  </select>
  <p id="err-comuna" class={errorCls}>Selecciona la comuna.</p>
</div>

<script>
  // Sin este import el select queda como está servido: las 346 comunas juntas,
  // que sigue siendo usable.
  import '@lib/selectDependiente';
</script>
