---
import IconoTraccion from '@components/filtros/IconoTraccion.astro';
import type { CategoriaDeal, Deal } from '@lib/tipos';
import { resolverUrlImagen } from '@lib/cdn';
import { formatearPrecio, formatearKm } from '@lib/formato';

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;
const urlImagen = resolverUrlImagen(deal.url_imagen);

// El aviso de un particular ya vive en CarFlip: su `url` es la canónica propia,
// así que no se abre en pestaña nueva ni se anuncia como enlace a otro portal.
const esInterno = deal.fuente === 'particular';

const fuenteLabels: Record<Deal['fuente'], string> = {
  autocosmos: 'Autocosmos',
  yapo: 'Yapo',
  autosusados: 'AutosUsados',
  checkeados: 'Checkeados',
  particular: 'Particular',
};

// Jerarquía por relleno y borde, no por color: la escala es acromática y la
// etiqueta de texto siempre acompaña, así que no se pierde información.
const categoriaEstilos: Record<CategoriaDeal | 'sin_evaluar', { label: string; clases: string }> = {
  oportunidad_clara: { label: 'Oportunidad', clases: 'bg-ink text-canvas' },
  buen_precio:       { label: 'Buen precio', clases: 'bg-canvas text-ink border border-ink' },
  revisar:           { label: 'Revisar',     clases: 'bg-canvas  border border-muted' },
  descartar:         { label: 'Descartar',   clases: 'bg-canvas  border border-line' },
  sin_evaluar:       { label: 'Sin evaluar', clases: 'bg-canvas  border border-line' },
};

const badge = categoriaEstilos[deal.categoria ?? 'sin_evaluar'];

const pctMercado = deal.pct_vs_mercado;
const riesgosVisibles = deal.riesgos.slice(0, 3);
const riesgosExtra = deal.riesgos.length - riesgosVisibles.length;

const metaItems = [
  deal.anio ? String(deal.anio) : null,
  deal.km !== null ? formatearKm(deal.km) : null,
  deal.ubicacion ?? null,
].filter(Boolean);
---

<article class="group border border-line hover:border-ink transition-colors duration-200">
  <a
    href={deal.url}
    target={esInterno ? undefined : '_blank'}
    rel={esInterno ? undefined : 'noopener noreferrer'}
    aria-label={esInterno ? `Ver ${deal.titulo}` : `Ver ${deal.titulo} en ${fuenteLabels[deal.fuente]}`}
    class="block"
  >
    <!-- Imagen con badge de categoría IA -->
    <div class="aspect-[16/10] bg-surface relative">
      {urlImagen ? (
        <img
          src={urlImagen}
          alt={deal.titulo}
          width={640}
          height={400}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center  text-base">Sin imagen</div>
      )}

      <!-- Badge de categoría: protagonista en esta pantalla -->
      <div class="absolute top-element right-element">
        <span class={`text-base px-3 py-1 ${badge.clases}`}>
          {badge.label}
        </span>
      </div>

      <!-- Fuente -->
      <div class="absolute top-element left-element">
        <span class="text-sm px-2 py-0.5 bg-canvas/75 ">
          {fuenteLabels[deal.fuente]}
        </span>
      </div>
    </div>

    <!-- Contenido -->
    <div class="p-element">
      <h2 class="text-base  line-clamp-2 leading-snug mb-4">
        {deal.titulo}
      </h2>

      <!-- Precio + puntaje IA -->
      <div class="flex items-baseline justify-between gap-2 mb-1.5">
        <span class="text-2xl text-ink tabular-nums">
          {formatearPrecio(deal.precio, deal.moneda)}
        </span>
        {deal.puntaje !== null && (
          <span class="text-base text-ink tabular-nums" title="Puntaje IA (0-100)">
            {deal.puntaje}<span class="">/100</span>
          </span>
        )}
      </div>

      <!-- Precio vs mercado -->
      {pctMercado !== null && pctMercado < 0 && (
        <p class="text-base text-ink mb-1 tabular-nums">
          ▼ {Math.abs(pctMercado).toFixed(1)}% vs mercado
          {deal.precio_mercado !== null && (
            <span class=""> ({formatearPrecio(deal.precio_mercado, deal.moneda)})</span>
          )}
        </p>
      )}

      <!-- Bajada de precio propia del aviso -->
      {deal.delta_pct !== null && deal.delta_pct < 0 && (
        <p class="text-base  mb-1 tabular-nums">
          Bajó {Math.abs(deal.delta_pct).toFixed(1)}% desde que lo vimos
        </p>
      )}

      <!-- Riesgos detectados por la IA -->
      {riesgosVisibles.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-3 mb-1">
          {riesgosVisibles.map((riesgo) => (
            <span class="text-sm px-2 py-0.5  border border-line">
              {riesgo}
            </span>
          ))}
          {riesgosExtra > 0 && (
            <span class="text-sm px-2 py-0.5  border border-line">
              +{riesgosExtra}
            </span>
          )}
        </div>
      )}

      <!-- Resumen IA -->
      {deal.resumen && (
        <p class="text-base  line-clamp-2 mt-3 mb-1">{deal.resumen}</p>
      )}

      {(metaItems.length > 0 || deal.traccion) && (
        <p class="text-base flex items-center gap-2 min-w-0 mt-3">
          {metaItems.length > 0 && <span class="truncate">{metaItems.join(' · ')}</span>}
          {deal.traccion && (
            <span class="inline-flex items-center gap-1 shrink-0">
              <IconoTraccion traccion={deal.traccion} />
              {deal.traccion}
            </span>
          )}
        </p>
      )}
    </div>
  </a>
</article>
