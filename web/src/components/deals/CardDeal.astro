---
import type { CategoriaDeal, Deal } from '@lib/tipos';
import { resolverUrlImagen } from '@lib/cdn';
import { formatearPrecio, formatearKm } from '@lib/formato';

interface Props {
  deal: Deal;
}

const { deal } = Astro.props;
const urlImagen = resolverUrlImagen(deal.url_imagen);

const fuenteLabels: Record<Deal['fuente'], string> = {
  autocosmos: 'Autocosmos',
  yapo: 'Yapo',
  mercadolibre: 'MercadoLibre',
};

const categoriaEstilos: Record<CategoriaDeal | 'sin_evaluar', { label: string; clases: string }> = {
  oportunidad_clara: { label: 'Oportunidad', clases: 'bg-green-500 text-zinc-950' },
  buen_precio:       { label: 'Buen precio', clases: 'bg-amber-400 text-zinc-900' },
  revisar:           { label: 'Revisar',     clases: 'bg-zinc-700 text-zinc-200' },
  descartar:         { label: 'Descartar',   clases: 'bg-red-500 text-zinc-950' },
  sin_evaluar:       { label: 'Sin evaluar', clases: 'bg-zinc-800 text-zinc-400' },
};

const badge = categoriaEstilos[deal.categoria ?? 'sin_evaluar'];

const pctMercado = deal.pct_vs_mercado;
const riesgosVisibles = deal.riesgos.slice(0, 3);
const riesgosExtra = deal.riesgos.length - riesgosVisibles.length;

const metaItems = [
  deal.anio ? String(deal.anio) : null,
  deal.km !== null ? formatearKm(deal.km) : null,
  deal.ubicacion ?? null,
].filter(Boolean);
---

<article class="group bg-zinc-900 rounded-xl overflow-hidden border border-zinc-800/50 hover:border-zinc-700 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-zinc-950/60">
  <a
    href={deal.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Ver ${deal.titulo} en ${fuenteLabels[deal.fuente]}`}
    class="block"
  >
    <!-- Imagen con badge de categoría IA -->
    <div class="aspect-[4/3] bg-zinc-800 relative overflow-hidden">
      {urlImagen ? (
        <img
          src={urlImagen}
          alt={deal.titulo}
          width={400}
          height={300}
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300 ease-out"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-zinc-700 text-xs">Sin imagen</div>
      )}

      <!-- Badge de categoría: protagonista en esta pantalla -->
      <div class="absolute top-2.5 right-2.5">
        <span class={`text-xs font-black px-2.5 py-1 rounded-lg shadow-lg ${badge.clases}`}>
          {badge.label}
        </span>
      </div>

      <!-- Fuente -->
      <div class="absolute top-2.5 left-2.5">
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-zinc-950/75 text-zinc-300 backdrop-blur-sm">
          {fuenteLabels[deal.fuente]}
        </span>
      </div>
    </div>

    <!-- Contenido -->
    <div class="p-4">
      <h2 class="text-sm font-medium text-zinc-200 line-clamp-2 leading-snug mb-3">
        {deal.titulo}
      </h2>

      <!-- Precio + puntaje IA -->
      <div class="flex items-baseline justify-between gap-2 mb-1">
        <span class="text-xl font-bold text-amber-400 tabular-nums">
          {formatearPrecio(deal.precio, deal.moneda)}
        </span>
        {deal.puntaje !== null && (
          <span class="text-sm font-black text-zinc-300 tabular-nums" title="Puntaje IA (0-100)">
            {deal.puntaje}<span class="text-[10px] font-semibold text-zinc-600">/100</span>
          </span>
        )}
      </div>

      <!-- Precio vs mercado -->
      {pctMercado !== null && pctMercado < 0 && (
        <p class="text-xs font-semibold text-green-500 mb-1 tabular-nums">
          ▼ {Math.abs(pctMercado).toFixed(1)}% vs mercado
          {deal.precio_mercado !== null && (
            <span class="text-zinc-600 font-normal"> ({formatearPrecio(deal.precio_mercado, deal.moneda)})</span>
          )}
        </p>
      )}

      <!-- Bajada de precio propia del aviso -->
      {deal.delta_pct !== null && deal.delta_pct < 0 && (
        <p class="text-[11px] text-green-600 mb-1 tabular-nums">
          Bajó {Math.abs(deal.delta_pct).toFixed(1)}% desde que lo vimos
        </p>
      )}

      <!-- Riesgos detectados por la IA -->
      {riesgosVisibles.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-2 mb-1">
          {riesgosVisibles.map((riesgo) => (
            <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20">
              {riesgo}
            </span>
          ))}
          {riesgosExtra > 0 && (
            <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-500">
              +{riesgosExtra}
            </span>
          )}
        </div>
      )}

      <!-- Resumen IA -->
      {deal.resumen && (
        <p class="text-xs text-zinc-500 line-clamp-2 mt-2 mb-1">{deal.resumen}</p>
      )}

      {metaItems.length > 0 && (
        <p class="text-xs text-zinc-600 truncate mt-2">{metaItems.join(' · ')}</p>
      )}
    </div>
  </a>
</article>
