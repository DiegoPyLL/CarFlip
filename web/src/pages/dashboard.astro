---
import Base from '@layouts/Base.astro';
import { obtenerMetricasCatalogo } from '@lib/db';
import { formatearFechaHora } from '@lib/formato';
import { mensajeDeError } from '@lib/publicaciones/limites';
import { listarReportes } from '@lib/publicaciones/moderacion';
import { ETIQUETA_ESTADO, ETIQUETA_REPORTE } from '@lib/publicaciones/opciones';

// El middleware ya exige rol de administrador, pero la autorización de una vista
// de admin no debería depender de un solo predicado de string en otra capa: se
// recomprueba acá igual que en `api/moderacion/[id].ts`.
if (Astro.locals.usuario?.rol !== 'admin') return Astro.rewrite('/403');

const [cat, reportes] = await Promise.all([
  obtenerMetricasCatalogo(),
  Astro.locals.supabase ? listarReportes(Astro.locals.supabase) : [],
]);

const pendientes = reportes.filter((r) => r.estado === 'pendiente');
const cerrados = reportes.filter((r) => r.estado !== 'pendiente');

// El resultado viaja como código, igual que en /cuenta: la página elige el
// texto y nadie puede inyectar uno por querystring.
const moderado = Astro.url.searchParams.get('moderado');
const AVISO_MODERACION: Record<string, string> = {
  despublicar: 'Aviso despublicado y reportes marcados como resueltos.',
  descartar: 'Reportes descartados. El aviso sigue publicado.',
};
const mensajeModeracion = moderado ? AVISO_MODERACION[moderado] : undefined;
const errorModeracion = mensajeDeError(Astro.url.searchParams.get('error'));

const accionCls =
  'text-base underline underline-offset-4 hover:text-ink transition-colors duration-150 cursor-pointer';

// Estados de KPI — acromáticos salvo `critical`, único gasto del acento escarlata
// en esta pantalla. Color + texto siempre juntos (nunca color solo).
type Estado = 'good' | 'warning' | 'critical';
const COLOR_ESTADO: Record<Estado, string> = {
  good: '#ffffff',
  warning: '#a0a0a0',
  critical: '#e4002b',
};
const TEXTO_ESTADO: Record<Estado, string> = {
  good: 'Cumple la meta',
  warning: 'Cerca de la meta',
  critical: 'Fuera de meta',
};

// Rampa acromática descendente: la jerarquía la da el tono, no el matiz. La
// etiqueta de texto siempre acompaña, nunca se codifica solo por tono (CVD floor).
const ORDEN_ESTADOS = ['publicado', 'pausado', 'vendido'] as const;
const COLOR_ESTADO_AVISO: Record<string, string> = {
  publicado: '#ffffff',
  pausado: '#a0a0a0',
  vendido: '#707070',
};

const CATEGORIA_DEAL: Record<string, { nombre: string; color: string }> = {
  oportunidad_clara: { nombre: 'Oportunidad clara', color: '#ffffff' },
  buen_precio: { nombre: 'Buen precio', color: '#c0c0c0' },
  revisar: { nombre: 'Revisar', color: '#a0a0a0' },
  descartar: { nombre: 'Descartar', color: '#707070' },
};

// Un aviso sin foto de portada rinde mucho peor: es el único KPI del catálogo
// con una meta accionable, porque se arregla avisando al dueño.
const publicados = cat.porEstado.publicado;
const sinFotoPct = publicados > 0 ? (cat.sinFoto / publicados) * 100 : null;
const estadoFotos: Estado =
  sinFotoPct === null ? 'warning' : sinFotoPct <= 2 ? 'good' : sinFotoPct <= 10 ? 'warning' : 'critical';

const maxPorEstado = Math.max(...ORDEN_ESTADOS.map((e) => cat.porEstado[e]), 1);
---

<Base
  titulo="Dashboard"
  descripcion="Estado del catálogo de avisos y de la selección de oportunidades de CarFlip."
  noindex
>
  <!-- Header -->
  <div class="mb-section">
    <p class="text-base  uppercase tracking-widest mb-2">Sala de máquinas</p>
    <h1 class="text-3xl text-ink mb-3">Dashboard</h1>
    <p class="text-base  max-w-xl">
      Estado del catálogo de avisos, calidad de las publicaciones y moderación.
    </p>
  </div>

  <!-- Moderación primero: es lo único de esta pantalla que exige una acción. -->
  <section id="reportes" class="bg-surface border border-line mb-element">
    <div class="p-element border-b border-line flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <h2 class="text-base text-ink">Reportes de avisos</h2>
        <p class="text-base mt-0.5">Denuncias sobre publicaciones de particulares</p>
      </div>
      <span class="text-base tabular-nums shrink-0">
        {pendientes.length} {pendientes.length === 1 ? 'pendiente' : 'pendientes'}
      </span>
    </div>

    {errorModeracion && (
      <p class="px-5 py-2.5 border-b border-scarlet-signal text-base text-ink" role="alert">
        {errorModeracion}
      </p>
    )}

    {mensajeModeracion && (
      <p class="px-5 py-2.5 border-b border-line text-base text-ink" role="status">
        {mensajeModeracion}
      </p>
    )}

    {pendientes.length === 0 ? (
      <p class="p-element text-base">Sin reportes pendientes.</p>
    ) : (
      <ul class="divide-y divide-line">
        {pendientes.map((r) => (
          <li class="p-element flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex items-baseline gap-3 flex-wrap">
                <span class="text-base text-ink">{r.motivo}</span>
                <span class="text-base tabular-nums">{formatearFechaHora(new Date(r.creado_en))}</span>
                <span class="text-sm border border-line-strong px-2 py-0.5">
                  {ETIQUETA_ESTADO[r.estadoAviso]}
                </span>
              </div>
              <a
                href={`/auto/p/${r.aviso_id}`}
                class="block text-base text-ink underline underline-offset-4 mt-1 truncate"
              >
                {r.titulo}
              </a>
              {r.detalle && <p class="text-base leading-relaxed mt-1">{r.detalle}</p>}
            </div>

            <div class="flex items-center gap-element shrink-0">
              {r.estadoAviso === 'publicado' && (
                <form method="POST" action={`/api/moderacion/${r.id}`}>
                  <input type="hidden" name="accion" value="despublicar" />
                  <button type="submit" class={accionCls}>Despublicar</button>
                </form>
              )}
              <form method="POST" action={`/api/moderacion/${r.id}`}>
                <input type="hidden" name="accion" value="descartar" />
                <button type="submit" class={accionCls}>Descartar</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )}

    {cerrados.length > 0 && (
      <details class="border-t border-line">
        <summary class="p-element text-base cursor-pointer">
          {cerrados.length} {cerrados.length === 1 ? 'reporte ya revisado' : 'reportes ya revisados'}
        </summary>
        <ul class="divide-y divide-line border-t border-line">
          {cerrados.map((r) => (
            <li class="px-5 py-2.5 flex flex-wrap items-baseline justify-between gap-3">
              <span class="text-base truncate">{r.motivo} · {r.titulo}</span>
              <span class="text-base shrink-0">{ETIQUETA_REPORTE[r.estado]}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  <!-- KPI row — Catálogo -->
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-element mb-element">

    <!-- Avisos publicados -->
    <div class="border border-line p-element">
      <p class="text-base  uppercase tracking-widest">Avisos publicados</p>
      <p class="text-3xl text-ink mt-2">{publicados.toLocaleString('es-CL')}</p>
      <p class="text-base  mt-2">
        {cat.totalAvisos.toLocaleString('es-CL')} en total, contando pausados y vendidos
      </p>
    </div>

    <!-- Nuevos -->
    <div class="border border-line p-element">
      <p class="text-base  uppercase tracking-widest">Nuevos · 7 d</p>
      <p class="text-3xl text-ink mt-2">{cat.nuevos7d.toLocaleString('es-CL')}</p>
      <p class="text-base  mt-2">{cat.nuevos24h.toLocaleString('es-CL')} en las últimas 24 h</p>
    </div>

    <!-- Bajadas de precio -->
    <div class="border border-line p-element">
      <p class="text-base  uppercase tracking-widest">Bajaron de precio · 7 d</p>
      <p class="text-3xl text-ink mt-2">{cat.bajadas7d.toLocaleString('es-CL')}</p>
      <p class="text-base  mt-2">Son la vía de entrada alternativa a Deals</p>
    </div>

    <!-- Avisos sin foto -->
    <div class="border border-line p-element">
      <p class="text-base  uppercase tracking-widest">Publicados sin foto</p>
      <p class="text-3xl text-ink mt-2">
        {sinFotoPct !== null ? `${sinFotoPct.toFixed(1)}%` : '—'}
      </p>
      <div class="flex items-center gap-1.5 mt-2">
        <span class="w-2 h-2 shrink-0" style={`background:${COLOR_ESTADO[estadoFotos]}`}></span>
        <span class="text-base ">{TEXTO_ESTADO[estadoFotos]} · meta &lt; 2%</span>
      </div>
      <div
        class="relative h-1.5 bg-line mt-3"
        title={`${cat.sinFoto.toLocaleString('es-CL')} avisos publicados sin foto de portada, sobre ${publicados.toLocaleString('es-CL')}`}
      >
        <div
          class="h-full"
          style={`width:${Math.min(100, (sinFotoPct ?? 0) * 10)}%;background:${COLOR_ESTADO[estadoFotos]}`}
        ></div>
        <div class="absolute top-0 bottom-0 w-px bg-muted" style="left:20%"></div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-[1fr_380px] gap-element">

    <!-- Catálogo por estado -->
    <section class="bg-surface border border-line">
      <div class="p-element border-b border-line">
        <h2 class="text-base text-ink">Catálogo por estado</h2>
        <p class="text-base  mt-0.5">Cómo se reparten los avisos que publicaron los usuarios</p>
      </div>
      <div class="p-element space-y-element">
        {cat.totalAvisos === 0 ? (
          <p class="text-base ">Todavía no hay avisos publicados.</p>
        ) : (
          ORDEN_ESTADOS.map((estado) => {
            const total = cat.porEstado[estado];
            const pct = (total / cat.totalAvisos) * 100;
            return (
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="inline-flex items-center gap-2">
                    <span class="w-2.5 h-2.5 shrink-0" style={`background:${COLOR_ESTADO_AVISO[estado]}`}></span>
                    <span class="text-base text-ink">{ETIQUETA_ESTADO[estado]}</span>
                  </span>
                  <span class="text-base  tabular-nums ml-3 shrink-0">
                    {total.toLocaleString('es-CL')} · {pct.toFixed(1)}%
                  </span>
                </div>
                <div class="h-5">
                  <div
                    class="h-full"
                    style={`width:${((total / maxPorEstado) * 100).toFixed(1)}%;background:${COLOR_ESTADO_AVISO[estado]}`}
                  ></div>
                </div>
              </div>
            );
          })
        )}
      </div>
    </section>

    <!-- Deals activos -->
    <section class="bg-surface border border-line">
      <div class="p-element border-b border-line flex items-baseline justify-between">
        <div>
          <h2 class="text-base text-ink">Deals activos</h2>
          <p class="text-base  mt-0.5">Categorizados por IA</p>
        </div>
        <a href="/deals" class="text-base text-ink hover: transition-colors">Ver deals →</a>
      </div>
      <div class="p-element">
        {cat.dealsPorCategoria.length === 0 ? (
          <p class="text-base ">
            Sin deals activos por ahora. Un aviso entra a la selección cuando su grupo
            marca/modelo/año reúne suficientes comparables.
          </p>
        ) : (
          <>
            <p class="text-4xl text-ink">{cat.dealsActivos.toLocaleString('es-CL')}</p>
            <p class="text-base  mt-1 mb-4">oportunidades vigentes</p>
            <div class="space-y-2.5">
              {cat.dealsPorCategoria.map((d) => {
                const categoria = CATEGORIA_DEAL[d.categoria] ?? { nombre: d.categoria, color: '#484848' };
                return (
                  <div class="flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-2 h-2 shrink-0" style={`background:${categoria.color}`}></span>
                      <span class="text-base ">{categoria.nombre}</span>
                    </span>
                    <span class="text-base text-ink tabular-nums">{d.total.toLocaleString('es-CL')}</span>
                  </div>
                );
              })}
            </div>
          </>
        )}
      </div>
    </section>
  </div>
</Base>
