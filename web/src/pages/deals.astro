---
import Base from '@layouts/Base.astro';
import AutoSubmit from '@components/AutoSubmit.astro';
import CardDeal from '@components/deals/CardDeal.astro';
import { obtenerDeals } from '@lib/db';
import type { CategoriaDeal, FuenteDeal } from '@lib/tipos';

const params = Astro.url.searchParams;

// Filtros propios de esta página (la tabla deals incluye mercadolibre,
// a diferencia de FiltrosAviso del listado general).
const fuentesValidas: FuenteDeal[] = ['autocosmos', 'yapo', 'mercadolibre', 'particular'];
const categoriasValidas: CategoriaDeal[] = ['oportunidad_clara', 'buen_precio', 'revisar'];

const fuenteParam = params.get('fuente') ?? '';
const fuente = fuentesValidas.includes(fuenteParam as FuenteDeal)
  ? (fuenteParam as FuenteDeal)
  : undefined;

const categoriaParam = params.get('categoria') ?? '';
const categoria = categoriasValidas.includes(categoriaParam as CategoriaDeal)
  ? (categoriaParam as CategoriaDeal)
  : undefined;

const deals = await obtenerDeals(fuente, categoria, 48);

// Stats para el header
const totalDeals = deals.length;
const totalOportunidades = deals.filter(d => d.categoria === 'oportunidad_clara').length;
const conPuntaje = deals.filter(d => d.puntaje !== null);
const puntajePromedio = conPuntaje.length > 0
  ? conPuntaje.reduce((acc, d) => acc + (d.puntaje ?? 0), 0) / conPuntaje.length
  : null;

// Ambos grupos de filtros comparten markup: se declaran como datos y se recorren.
const gruposFiltro = [
  {
    name: 'fuente',
    label: 'Fuente',
    activo: fuente ?? '',
    opciones: [
      { value: '', label: 'Todas' },
      { value: 'autocosmos', label: 'Autocosmos' },
      { value: 'yapo', label: 'Yapo' },
      { value: 'mercadolibre', label: 'MercadoLibre' },
      { value: 'particular', label: 'Particulares' },
    ],
  },
  {
    name: 'categoria',
    label: 'Categoría',
    activo: categoria ?? '',
    opciones: [
      { value: '', label: 'Todas' },
      { value: 'oportunidad_clara', label: 'Oportunidad' },
      { value: 'buen_precio', label: 'Buen precio' },
      { value: 'revisar', label: 'Revisar' },
    ],
  },
];
---

<Base
  titulo="Deals — Oportunidades de compra detectadas con IA"
  descripcion="Autos en Chile con precio bajo su valor de mercado, evaluados por IA: categoría, puntaje y riesgos detectados en el aviso."
>

  <!-- Header de sección -->
  <div class="mb-section">
    <p class="text-base  uppercase tracking-widest mb-element">Oportunidades de compra</p>
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-element">Deals</h1>
    <p class="text-base  max-w-xl">
      Autos publicados bajo su precio de mercado (comparados contra avisos similares de la misma
      marca, modelo y año). Cada deal es evaluado por IA, que lee el aviso para detectar riesgos.
    </p>
  </div>

  <!-- Stats: pares label/valor apilados, sin cajas ni separadores -->
  {totalDeals > 0 && (
    <div class="flex flex-wrap gap-x-block gap-y-element mb-block pb-block border-b border-line">
      <div>
        <p class="text-base ">Deals activos</p>
        <p class="text-base text-ink tabular-nums">{totalDeals}</p>
      </div>
      <div>
        <p class="text-base ">Oportunidades claras</p>
        <p class="text-base text-ink tabular-nums">{totalOportunidades}</p>
      </div>
      {puntajePromedio !== null && (
        <div>
          <p class="text-base ">Puntaje promedio</p>
          <p class="text-base text-ink tabular-nums">{puntajePromedio.toFixed(0)}/100</p>
        </div>
      )}
    </div>
  )}

  <!-- Filtros -->
  <form method="GET" action="/deals" class="mb-block space-y-element" data-autosubmit>
    {gruposFiltro.map(({ name, label, activo, opciones }) => (
      <fieldset class="flex flex-wrap items-center gap-element">
        <legend class="sr-only">{label}</legend>
        <span class="text-sm  uppercase tracking-wider shrink-0 w-full sm:w-24" aria-hidden="true">{label}</span>
        <div class="flex flex-wrap gap-2">
          {opciones.map(({ value, label: opcion }) => (
            <label class="cursor-pointer select-none shrink-0">
              <input
                type="radio"
                name={name}
                value={value}
                class="sr-only peer"
                checked={activo === value}
              />
              <span class="block px-3 py-2 text-base border border-line-strong  peer-checked:bg-ink peer-checked:text-canvas peer-checked:border-ink peer-focus-visible:border-scarlet-signal hover:border-ink hover:text-ink transition-colors whitespace-nowrap">
                {opcion}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
  </form>

  <!-- Grid de deals -->
  {totalDeals > 0 ? (
    <div
      id="deals-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-element"
    >
      {deals.map((deal) => (
        <CardDeal deal={deal} />
      ))}
    </div>
  ) : (
    <div class="py-section border border-line p-element">
      <p class="text-2xl text-ink">Sin deals disponibles ahora</p>
      <p class="text-base  mt-element max-w-md">
        Los deals aparecen cuando detectamos un aviso publicado bajo el precio de mercado
        de vehículos comparables. Vuelve a revisar después de la próxima actualización.
      </p>
      <a href="/avisos" class="mt-block inline-flex items-center gap-2 text-base text-ink hover: transition-colors">
        <span class="w-1.5 h-1.5 bg-scarlet-signal shrink-0" aria-hidden="true"></span>
        Ver todos los avisos
      </a>
    </div>
  )}

  <AutoSubmit />
</Base>
