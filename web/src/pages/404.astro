---
import PaginaError from '@layouts/PaginaError.astro';

// Astro sirve esta página tanto en las rutas sin coincidencia como cuando otra
// la reescribe con `Astro.rewrite('/404')`, que es lo que convierte un aviso
// pausado o vendido en un 404 de verdad.
---

<PaginaError
  codigo={404}
  titulo="Página no encontrada"
  descripcion="La página que buscas no existe o dejó de estar disponible."
  encabezado="Esta página ya no está."
  accion={{ href: '/avisos', texto: 'Ver todos los avisos' }}
>
  El enlace puede estar mal escrito, o el aviso se vendió y su publicación se dio de baja.
</PaginaError>
