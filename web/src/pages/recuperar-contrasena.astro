---
import Base from '@layouts/Base.astro';
import { parrafoCls } from '@lib/marketing';
import { PATRON } from '@lib/regex';
import { COOKIE_EMAIL_PENDIENTE } from '@lib/auth/servidor';

// Página utilitaria y fuera del índice, como /entrar y /registro: no aporta
// contenido rastreable y no debe competir con las páginas de producto.
if (Astro.locals.usuario) return Astro.redirect('/cuenta/seguridad');

const enviado = Astro.url.searchParams.has('enviado');
const reenviado = Astro.url.searchParams.has('reenviado');

// Solo ahorra retipear el correo en el paso del código. Si falta —porque el
// correo se abre en otro dispositivo— el campo sale vacío y se escribe a mano,
// que es justamente lo que un enlace de un solo uso no permitiría.
const emailPendiente = Astro.cookies.get(COOKIE_EMAIL_PENDIENTE)?.value ?? '';

const error = Astro.url.searchParams.get('error');
const MENSAJES_ERROR: Record<string, string> = {
  config: 'La recuperación de contraseña no está disponible en este momento.',
  email: 'Ingresa un correo electrónico válido.',
  codigo: 'El código no es válido o ya expiró. Pide uno nuevo.',
};
const mensajeError = error
  ? (MENSAJES_ERROR[error] ?? 'No pudimos completar la recuperación. Inténtalo de nuevo.')
  : null;

const inputCls =
  'w-full bg-field border border-line-strong px-4 py-2.5 text-base text-ink focus:outline-hidden focus:border-scarlet-signal transition-colors duration-150';
const botonCls =
  'inline-flex items-center gap-2 text-base text-ink border border-ink px-6 py-2.5 hover:bg-ink hover:text-canvas transition-colors duration-150';
const enlaceCls =
  'text-base text-ink-on-accent underline underline-offset-4 hover:opacity-70 transition-opacity duration-150 cursor-pointer';
---

<Base
  titulo="Recuperar contraseña"
  descripcion="Recupera el acceso a tu cuenta de CarFlip."
  noindex
>
  <div class="max-w-md mx-auto">
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-block text-balance">
      Recupera tu cuenta.
    </h1>

    {mensajeError && (
      <div class="mb-element px-6 py-2.5 border border-scarlet-signal text-base text-ink" role="alert">
        {mensajeError}
      </div>
    )}

    {enviado ? (
      <>
        <p class={`${parrafoCls} mb-element`}>
          Si esa dirección tiene una cuenta, te enviamos un código de ocho dígitos. Escríbelo aquí
          para elegir una contraseña nueva.
        </p>

        {reenviado && (
          <div class="mb-element px-6 py-2.5 border border-line-strong text-base text-ink" role="status">
            Te enviamos un código nuevo.
          </div>
        )}

        <form
          method="POST"
          action="/api/auth/recuperar/confirmar"
          class="bg-accent bloque-acento p-element space-y-element"
        >
          <div>
            <label for="email" class="flex items-baseline justify-between text-base text-ink mb-2">
              Email <span class="text-sm text-scarlet-signal">*Requerido</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              value={emailPendiente}
              required
              maxlength="200"
              autocomplete="email"
              aria-describedby="err-email"
              class={`${inputCls} campo`}
            />
            <p id="err-email" class="campo-error text-sm text-scarlet-signal mt-1.5">
              Ingresa un correo electrónico válido.
            </p>
          </div>

          <div>
            <label for="codigo" class="flex items-baseline justify-between text-base text-ink mb-2">
              Código <span class="text-sm text-scarlet-signal">*Requerido</span>
            </label>
            <input
              type="text"
              id="codigo"
              name="codigo"
              required
              inputmode="numeric"
              pattern={PATRON.codigo}
              maxlength="8"
              autocomplete="one-time-code"
              aria-describedby="err-codigo"
              class={`${inputCls} campo tracking-[0.4em]`}
            />
            <p id="err-codigo" class="campo-error text-sm text-scarlet-signal mt-1.5">
              Son los ocho dígitos que llegaron a tu correo.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-element pt-2">
            <button type="submit" class={botonCls}>
              Continuar
              <span aria-hidden="true">→</span>
            </button>

            <!--
              `formnovalidate` porque el código es `required` y sin esto el
              navegador bloquearía el reenvío justo cuando no se tiene el código.
              El servidor valida el correo igual. El campo oculto distingue el
              reenvío del primer envío, que comparten endpoint.
            -->
            <button
              type="submit"
              formaction="/api/auth/recuperar"
              formnovalidate
              name="reenviar"
              value="1"
              class={enlaceCls}
            >
              Reenviar código
            </button>
          </div>
        </form>
      </>
    ) : (
      <>
        <p class={`${parrafoCls} mb-element`}>
          Escribe tu correo y te enviamos un código para elegir una contraseña nueva.
        </p>

        <form method="POST" action="/api/auth/recuperar" class="bg-accent bloque-acento p-element space-y-element">
          <div>
            <label for="email" class="flex items-baseline justify-between text-base text-ink mb-2">
              Email <span class="text-sm text-scarlet-signal">*Requerido</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              maxlength="200"
              autocomplete="email"
              aria-describedby="err-email"
              class={`${inputCls} campo`}
            />
            <p id="err-email" class="campo-error text-sm text-scarlet-signal mt-1.5">
              Ingresa un correo electrónico válido.
            </p>
          </div>

          <button type="submit" class={botonCls}>
            Enviarme el código
            <span aria-hidden="true">→</span>
          </button>
        </form>
      </>
    )}

    <p class="mt-block text-base">
      ¿La recordaste? <a href="/entrar" class="text-ink underline underline-offset-4">Entra aquí</a>.
    </p>
  </div>
</Base>
