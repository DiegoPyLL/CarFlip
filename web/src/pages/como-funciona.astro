---
import Base from '@layouts/Base.astro';
import HeroMarketing from '@components/marketing/HeroMarketing.astro';
import ListaNumerada from '@components/marketing/ListaNumerada.astro';
import { seccionCls, rubroCls, parrafoCls } from '@lib/marketing';
import { scriptJsonLd } from '@lib/jsonLd';


const pasos = [
  {
    titulo: 'Los autos llegan de dos lados',
    texto: 'Cualquier persona puede publicar su auto directamente en CarFlip, gratis y con cuenta propia. En paralelo, las automotoras con acuerdo vigente entregan su catálogo, que se actualiza a diario.',
  },
  {
    titulo: 'Normalización',
    texto: 'Cada origen entrega los datos en un formato distinto. CarFlip convierte todo a un esquema común: misma estructura de campos, misma moneda, misma escala de kilometraje. Los duplicados se eliminan antes de guardar.',
  },
  {
    titulo: 'Detección de oportunidades',
    texto: 'CarFlip compara cada auto contra avisos similares de la misma marca, modelo y año para detectar precios bajo el mercado, y guarda el historial de precio de cada aviso para marcar las bajadas significativas. Los casos más claros pasan por una evaluación con IA que lee la descripción y resume riesgos.',
    enlace: { href: '/deals', texto: 'Deals' },
  },
  {
    titulo: 'Todo en un solo lugar',
    texto: 'Filtra por marca, año, kilometraje o precio sobre todo el catálogo a la vez. Cuando encuentras algo, contactas al vendedor desde la ficha del aviso.',
  },
];


const faq = [
  {
    pregunta: '¿CarFlip vende autos?',
    respuesta: 'No. CarFlip publica y compara avisos de terceros, pero no vende autos ni participa en la transacción. El contacto con el vendedor ocurre desde la ficha del aviso, y el trato se cierra entre las partes.',
  },
  {
    pregunta: '¿Usar CarFlip tiene algún costo?',
    respuesta: 'No. Buscar, comparar y publicar tu auto es gratis. No cobramos comisión por venta, no vendemos autos y ningún vendedor puede pagar por aparecer más arriba: el orden lo decide la comparación de precios, nunca la publicidad.',
  },
  {
    pregunta: '¿Necesito una cuenta para buscar en la plataforma?',
    respuesta: 'No. Buscar, filtrar y revisar los deals no requiere registro. La cuenta solo hace falta para publicar un auto propio o para ver el teléfono de un vendedor particular.',
  },
  {
    pregunta: '¿Cada cuánto se actualizan los datos?',
    respuesta: 'Los avisos de particulares aparecen al instante, apenas se publican. Los catálogos de automotoras se actualizan a diario, y los autos que salen de un catálogo se marcan como no disponibles.',
  },
  {
    pregunta: '¿Los precios son exactos?',
    respuesta: 'Son los que publicó el vendedor. Algunos no actualizan el precio en línea o negocian directamente. Siempre verifica con el vendedor antes de asumir el precio final.',
  },
  {
    pregunta: '¿Qué significa el badge de bajada de precio?',
    respuesta: 'Cuando detectamos que el precio de un aviso bajó respecto a la última vez que lo vimos, mostramos el porcentaje de bajada. Es útil para encontrar vendedores con urgencia de venta.',
  },
  {
    pregunta: '¿Qué es la sección Deals?',
    respuesta: 'Autos publicados bajo el precio de mercado de su marca, modelo y año. Los casos más relevantes se evalúan con IA, que revisa la descripción del aviso y entrega un puntaje y posibles riesgos a considerar antes de contactar al vendedor.',
  },
  {
    pregunta: '¿Cómo se calcula el precio de mercado de un auto?',
    respuesta: 'Con la mediana de los avisos comparables: misma marca, mismo modelo y año similar, sumando todo el catálogo del sitio. Se usa la mediana y no el promedio porque unos pocos precios extremos no la mueven. Si un modelo tiene muy pocos avisos comparables, no se le calcula precio de mercado: preferimos no mostrar una referencia poco confiable.',
  },
  {
    pregunta: '¿Qué IA evalúa los deals?',
    respuesta: 'Actualmente se usa el modelo de Llama 3.3. Recibe el título, la descripción, el precio y el contexto de mercado del aviso, y devuelve una categoría, un puntaje de 0 a 100 y una lista de riesgos concretos encontrados en el texto: motor fundido, sin papeles, chocado, kilometraje no acreditado. Es un lector rápido de descripciones, no un tasador. El plan es reemplazarlo por un modelo propio, entrenado con el historial de precios de CarFlip, cuando el volumen de datos lo justifique.',
  },
  {
    pregunta: '¿Qué tan confiable es el puntaje de la IA?',
    respuesta: 'Sirve para ordenar la lista, no para decidir una compra. El modelo solo lee lo que el vendedor escribió: si la descripción omite un problema, no hay forma de detectarlo. Antes de cerrar cualquier trato, revisa el auto en persona, pide la documentación y hazlo ver por un mecánico de confianza.',
  },
  {
    pregunta: '¿Por qué un auto muy barato no aparece en Deals?',
    respuesta: 'Por alguna de tres razones: su grupo comparable tiene pocos avisos y la referencia no sería confiable; el precio bajo se explica por un kilometraje muy superior al del resto del grupo; o la IA lo descartó porque la descripción menciona un daño grave, falta de papeles o un vehículo para repuestos.',
  },
  {
    pregunta: '¿Puedo publicar mi auto en CarFlip?',
    respuesta: 'Sí, y es gratis. Necesitas una cuenta con el correo confirmado, y el aviso queda visible de inmediato, sin cola de revisión. Cada cuenta admite hasta 5 avisos activos y 10 fotos por aviso. Los avisos que incumplen las condiciones de uso se retiran cuando se reportan.',
  },
  //{
  //  pregunta: '¿Seguridad',
  //  respuesta: 'corregir',
  //},
];

// El reparto en columnas se hace acá y no en CSS: `columns` de CSS rebalancea
// el contenido al abrir una card y los items saltan de columna. Partido a la
// mitad, cada pregunta se queda donde está. El orden de lectura pasa a ser
// vertical: la primera mitad baja por la columna izquierda y la segunda por la
// derecha.
const mitadFaq = Math.ceil(faq.length / 2);
const columnasFaq = [faq.slice(0, mitadFaq), faq.slice(mitadFaq)];

// FAQPage para buscadores y agentes de IA: mismo contenido que se renderiza
// abajo, sin duplicar el texto.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ pregunta, respuesta }) => ({
    '@type': 'Question',
    name: pregunta,
    acceptedAnswer: { '@type': 'Answer', text: respuesta },
  })),
};

// El nonce lo inyecta el middleware por request (CSP estricta). Se lee acá, en
// el scope del componente, y no directo en el atributo del <script slot="head">:
// cuando `Astro` se usa solo dentro de contenido de un slot, el compilador no
// deja el binding disponible en esa clausura y lanza "Astro is not defined".
const nonce = Astro.locals.nonce;

// Página de marketing del sitio (junto a /quienes-somos): ritmo editorial
// completo (títulos grandes, 120px entre secciones) que un grid de datos no
// toleraría. seccionCls/rubroCls viven en @lib/marketing.
---

<Base
  titulo="Cómo funciona CarFlip"
  descripcion="CarFlip reúne los avisos de particulares y los catálogos de automotoras de Chile, normaliza la información y detecta oportunidades de precio en tiempo real."
>
  <script is:inline nonce={nonce} slot="head" type="application/ld+json" set:html={scriptJsonLd(jsonLd)} />

  <div class="max-w-6xl">

    <!-- El tramo de lectura corrida se queda en la medida editorial (max-w-3xl);
         solo el mosaico de preguntas usa el ancho completo, que es lo que le
         permite abrir a dos columnas sin apretar la línea de texto. -->
    <div class="max-w-3xl">

      <!-- Hero -->
      <HeroMarketing rubro="Cómo funciona" titulo="Un comparador de precios, no una automotora.">
        CarFlip no vende autos. Reúne lo que publican los particulares y las automotoras con
        acuerdo, lo normaliza y lo deja en un solo lugar para que puedas comparar precios sin
        abrir cinco pestañas.
      </HeroMarketing>

      <!-- Proceso: numeración tipográfica, sin insignias ni conectores -->
      <section class={seccionCls}>
        <h2 class={rubroCls}>El proceso</h2>
        <ListaNumerada items={pasos} />
      </section>

    </div>


    <!-- Preguntas frecuentes: mosaico de 2×6 sobre <details> nativos, con el
         estado abierto/cerrado ya accesible por teclado y anunciado por el
         lector de pantalla. Las respuestas quedan en el DOM aunque la card esté
         cerrada, así que buscadores y agentes las leen igual (y coinciden con
         el FAQPage del <head>).
         `scroll-mt` compensa la barra fija (48px compacta) cuando se llega por el
         enlace "Preguntas Frecuentes" del footer. -->
    <section id="preguntas-frecuentes" class={`${seccionCls} scroll-mt-20`}>
      <h2 class={rubroCls}>Preguntas frecuentes</h2>

      <!-- Dos columnas independientes en vez de una grilla de 12 celdas: en una
           grilla, abrir una card empuja la fila completa y deja un hueco al lado.
           Cada columna es su propia pila, así que solo desplaza a las de abajo
           suyo. El mismo `gap-element` separa las columnas entre sí y las cards
           dentro de cada una, de modo que el aire es el mismo en los dos ejes.
           Dos columnas desde lg y no desde md: a 768px cada card mediría 370px y
           una pregunta de 26px se partiría en cuatro líneas. -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-element items-start">
        {columnasFaq.map((columna) => (
          <div class="flex flex-col gap-element">
            {columna.map(({ pregunta, respuesta }) => (
              <details class="desplegable group bg-surface border border-line open:border-ink hover:border-ink transition-colors duration-200">
                <summary class="flex items-start justify-between gap-element p-element cursor-pointer">
                  <h3 class="text-2xl text-ink leading-tight text-balance">{pregunta}</h3>
                  <svg
                    class="shrink-0 mt-2 transition-transform duration-200 group-open:rotate-45"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    stroke="currentColor"
                    stroke-width="1"
                    aria-hidden="true"
                  >
                    <path d="M0 8h16M8 0v16" />
                  </svg>
                </summary>
                <p class={`${parrafoCls} px-element pb-element`}>{respuesta}</p>
              </details>
            ))}
          </div>
        ))}
      </div>
    </section>



  </div>
</Base>

<!-- Tope de dos preguntas abiertas a la vez: al abrir la tercera se cierra la
     que lleva más tiempo abierta, para que la columna no crezca sin control y
     la comparación entre respuestas siga cabiendo en pantalla.
     El atributo `name` de <details> haría esto sin JS, pero deja abierta solo
     una. `toggle` no burbujea: se escucha en fase de captura sobre la sección,
     así basta un listener para las doce cards. Sin JS todo sigue funcionando,
     solo que sin el tope. -->
<script>
  const MAX_ABIERTAS = 2;
  const seccion = document.getElementById('preguntas-frecuentes');
  const abiertas: HTMLDetailsElement[] = [];

  seccion?.addEventListener(
    'toggle',
    (evento) => {
      const card = evento.target;
      if (!(card instanceof HTMLDetailsElement)) return;

      const posicion = abiertas.indexOf(card);

      if (!card.open) {
        if (posicion !== -1) abiertas.splice(posicion, 1);
        return;
      }

      if (posicion === -1) abiertas.push(card);
      while (abiertas.length > MAX_ABIERTAS) abiertas.shift()!.open = false;
    },
    true,
  );
</script>

