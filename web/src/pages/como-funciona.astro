---
import Base from '@layouts/Base.astro';
import HeroMarketing from '@components/marketing/HeroMarketing.astro';
import Cifras from '@components/marketing/Cifras.astro';
import ListaNumerada from '@components/marketing/ListaNumerada.astro';
import CtaAvisos from '@components/marketing/CtaAvisos.astro';
import { obtenerEstadisticas } from '@lib/db';
import { formatearPrecio } from '@lib/formato';
import { seccionCls, rubroCls } from '@lib/marketing';

const stats = await obtenerEstadisticas();

const pasos = [
  {
    titulo: 'Recopilación automática',
    texto: 'Todos los días un proceso recorre los portales activos y extrae todos los avisos de autos en venta. Descarga imágenes, precios, kilometraje, año y todos los datos disponibles del aviso.',
  },
  {
    titulo: 'Normalización',
    texto: 'Cada portal usa formatos distintos. CarFlip convierte todo a un esquema común: misma estructura de campos, misma moneda, misma escala de kilometraje. Los duplicados se eliminan antes de guardar.',
  },
  {
    titulo: 'Detección de oportunidades',
    texto: 'CarFlip compara cada auto contra avisos similares de la misma marca, modelo y año para detectar precios bajo el mercado, y guarda el historial de precio de cada aviso para marcar las bajadas significativas. Los casos más claros pasan por una evaluación con IA que lee la descripción y resume riesgos.',
    enlace: { href: '/deals', texto: 'Deals' },
  },
  {
    titulo: 'Todo en un solo lugar',
    texto: 'Filtra por marca, año, kilometraje o precio sobre todos los portales simultáneamente. Cuando encuentras algo, el botón "Ver aviso original" te lleva directo a la fuente para contactar al vendedor.',
  },
];

const fuentes = [
  { nombre: 'Autocosmos',   detalle: 'autocosmos.cl — actualización diaria',  activa: true },
  { nombre: 'Yapo',         detalle: 'yapo.cl — actualización diaria',        activa: true },
  { nombre: 'Autosusados',  detalle: 'autosusados.cl — actualización diaria', activa: true },
  { nombre: 'Checkeados',   detalle: 'checkeados.cl — actualización diaria',  activa: true },
  { nombre: 'MercadoLibre', detalle: 'Próximamente',                          activa: false },
];

const cifras = [
  { valor: stats.total_avisos.toLocaleString('es-CL'), label: 'avisos indexados' },
  {
    valor: stats.precio_promedio ? formatearPrecio(Math.round(stats.precio_promedio)) : '—',
    label: 'precio promedio',
  },
  { valor: stats.total_autocosmos.toLocaleString('es-CL'),  label: 'de Autocosmos' },
  { valor: stats.total_yapo.toLocaleString('es-CL'),        label: 'de Yapo' },
  { valor: stats.total_autosusados.toLocaleString('es-CL'), label: 'de Autosusados' },
  { valor: stats.total_checkeados.toLocaleString('es-CL'),  label: 'de Checkeados' },
];

const faq = [
  {
    pregunta: '¿CarFlip vende autos?',
    respuesta: 'No. CarFlip solo agrega y compara avisos de terceros. Para contactar al vendedor usa el botón "Ver aviso original" en cada ficha — te lleva directo al portal donde está publicado.',
  },
  {
    pregunta: '¿Cada cuánto se actualizan los datos?',
    respuesta: 'Todos los días. Los avisos nuevos aparecen en el siguiente ciclo de recopilación. Los que se eliminan del portal original se marcan como no disponibles.',
  },
  {
    pregunta: '¿Qué significa el badge de bajada de precio?',
    respuesta: 'Cuando detectamos que el precio de un aviso bajó respecto a la última vez que lo vimos, mostramos el porcentaje de bajada. Es útil para encontrar vendedores con urgencia de venta.',
  },
  {
    pregunta: '¿Qué es la sección Deals?',
    respuesta: 'Autos publicados bajo el precio de mercado de su marca, modelo y año. Los casos más relevantes se evalúan con IA, que revisa la descripción del aviso y entrega un puntaje y posibles riesgos a considerar antes de contactar al vendedor.',
  },
  {
    pregunta: '¿Los precios son exactos?',
    respuesta: 'Son los que aparecen publicados en cada portal. Algunos vendedores no actualizan el precio en línea o negocian directamente. Siempre verifica con el vendedor antes de asumir el precio final.',
  },
];

// Página de marketing del sitio (junto a /quienes-somos): ritmo editorial
// completo (títulos grandes, 120px entre secciones) que un grid de datos no
// toleraría. seccionCls/rubroCls viven en @lib/marketing.
---

<Base
  titulo="Cómo funciona CarFlip"
  descripcion="CarFlip recopila avisos de autos en venta desde los principales portales de Chile, normaliza la información y detecta oportunidades de precio en tiempo real."
>
  <div class="max-w-3xl">

    <!-- Hero -->
    <HeroMarketing rubro="Cómo funciona" titulo="Un comparador de precios, no un portal de autos.">
      CarFlip no publica avisos propios. Recopila automáticamente lo que otros portales publican,
      lo normaliza y lo deja en un solo lugar para que puedas comparar precios sin abrir cinco pestañas.
    </HeroMarketing>

    <!-- Proceso: numeración tipográfica, sin insignias ni conectores -->
    <section class={seccionCls}>
      <h2 class={rubroCls}>El proceso</h2>
      <ListaNumerada items={pasos} />
    </section>

    <!-- Fuentes activas -->
    <section class={seccionCls}>
      <h2 class={rubroCls}>Fuentes de datos</h2>

      <ul class="divide-y divide-line border-y border-line">
        {fuentes.map(({ nombre, detalle, activa }) => (
          <li class="flex items-baseline justify-between gap-element py-element">
            <span class={activa ? 'text-base text-ink' : 'text-base '}>
              {nombre}
            </span>
            <span class="text-base  text-right">{detalle}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Stats en vivo -->
    <section class={seccionCls}>
      <h2 class={rubroCls}>En este momento</h2>
      <Cifras cifras={cifras} />
    </section>

    <!-- Preguntas frecuentes: `scroll-mt` compensa el header sticky (h-12)
         cuando se llega por el enlace "Preguntas Frecuentes" del footer. -->
    <section id="preguntas-frecuentes" class={`${seccionCls} scroll-mt-20`}>
      <h2 class={rubroCls}>Preguntas frecuentes</h2>

      <div class="divide-y divide-line border-y border-line">
        {faq.map(({ pregunta, respuesta }) => (
          <div class="py-block">
            <h3 class="text-2xl text-ink mb-element">{pregunta}</h3>
            <p class="text-base  leading-relaxed">{respuesta}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <CtaAvisos />

  </div>
</Base>
