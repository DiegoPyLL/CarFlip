---
import Cuenta from '@layouts/Cuenta.astro';
import AvisoEstado from '@components/cuenta/AvisoEstado.astro';
import Notificacion from '@components/Notificacion.astro';
import FilaAviso from '@components/cuenta/FilaAviso.astro';
import { listarAvisosPropios, revelacionesPorAviso } from '@lib/publicaciones/consultas';
import { mensajeDeError } from '@lib/publicaciones/limites';
import { accionCls, botonCls } from '@lib/ui';

const usuario = Astro.locals.usuario;
if (!usuario || !Astro.locals.supabase) return Astro.redirect('/entrar?volver=/cuenta/avisos');

const avisos = await listarAvisosPropios(Astro.locals.supabase, usuario.id);
const revelaciones = await revelacionesPorAviso(
  Astro.locals.supabase,
  avisos.map((a) => a.id),
);

const activos = avisos.filter((a) => a.estado === 'publicado').length;
const mensajeError = mensajeDeError(Astro.url.searchParams.get('error'));
const guardado = Astro.url.searchParams.has('guardado');
const eliminado = Astro.url.searchParams.has('eliminado');
---

<Cuenta
  titulo="Mis publicaciones"
  descripcion="Gestiona los avisos que publicaste en CarFlip."
  usuario={usuario}
>
  <header class="flex flex-wrap items-end justify-between gap-element mb-block">
    <div>
      <h1 class="text-5xl sm:text-7xl text-ink leading-none text-balance">Mis publicaciones.</h1>
      <p class="text-base text-ink/70 mt-element tabular-nums">
        {activos} {activos === 1 ? 'aviso publicado' : 'avisos publicados'}
      </p>
    </div>
    <a href="/cuenta/avisos/nuevo" class={botonCls}>
      Publicar un auto
      <span aria-hidden="true">→</span>
    </a>
  </header>

  {mensajeError && <AvisoEstado tono="error">{mensajeError}</AvisoEstado>}
  {guardado && <Notificacion volver={Astro.url.pathname}>Cambios guardados.</Notificacion>}
  {eliminado && <Notificacion volver={Astro.url.pathname}>Publicación eliminada.</Notificacion>}

  {avisos.length === 0 ? (
    <div class="bg-surface border border-line p-block">
      <p class="text-2xl text-ink mb-element">Todavía no publicaste ningún auto.</p>
      <p class="text-base text-ink/70 leading-relaxed max-w-xl">
        Publica el tuyo y aparecerá en el listado junto al resto de los avisos del sitio.
        Necesitas tu nombre y teléfono cargados en
        <a href="/cuenta" class="text-ink underline underline-offset-4">tu cuenta</a>.
      </p>
    </div>
  ) : (
    <ul class="bg-surface border border-line divide-y divide-line">
      {avisos.map((aviso) => (
        <FilaAviso aviso={aviso} contactos={revelaciones.get(aviso.id) ?? 0}>
          {aviso.estado === 'publicado' ? (
            <form method="POST" action={`/api/publicacion/${aviso.id}/estado`}>
              <input type="hidden" name="estado" value="pausado" />
              <button type="submit" class={accionCls}>Pausar</button>
            </form>
          ) : (
            <form method="POST" action={`/api/publicacion/${aviso.id}/estado`}>
              <input type="hidden" name="estado" value="publicado" />
              <button type="submit" class={accionCls}>Republicar</button>
            </form>
          )}

          {aviso.estado !== 'vendido' && (
            <form method="POST" action={`/api/publicacion/${aviso.id}/estado`}>
              <input type="hidden" name="estado" value="vendido" />
              <button type="submit" class={accionCls}>Marcar vendido</button>
            </form>
          )}

          {aviso.estado === 'publicado' && (
            <a href={`/auto/p/${aviso.id}`} class={accionCls}>Ver aviso</a>
          )}
        </FilaAviso>
      ))}
    </ul>
  )}
</Cuenta>
