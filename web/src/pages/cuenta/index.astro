---
import Cuenta from '@layouts/Cuenta.astro';
import AvisoEstado from '@components/cuenta/AvisoEstado.astro';
import Notificacion from '@components/Notificacion.astro';
import Normalizacion from '@components/Normalizacion.astro';
import CamposUbicacion from '@components/cuenta/CamposUbicacion.astro';
import FilaAviso from '@components/cuenta/FilaAviso.astro';
import { listarAvisosPropios, obtenerPerfil, revelacionesPorAviso } from '@lib/publicaciones/consultas';
import { PALABRA_ELIMINAR, mensajeDeError, perfilCompleto } from '@lib/publicaciones/limites';
import { PATRON } from '@lib/regex';
import {
  botonCls,
  botonPeligroCls,
  campoCls,
  enlaceCls,
  errorCls,
  labelCls,
  requeridoCls,
} from '@lib/ui';

// El middleware ya redirige a /entrar si no hay sesión; la comprobación se
// repite aquí para que el tipo de `usuario` sea no nulo en el template.
const usuario = Astro.locals.usuario;
if (!usuario || !Astro.locals.supabase) return Astro.redirect('/entrar?volver=/cuenta');

const [perfil, avisos] = await Promise.all([
  obtenerPerfil(Astro.locals.supabase, usuario.id),
  listarAvisosPropios(Astro.locals.supabase, usuario.id),
]);
const revelaciones = await revelacionesPorAviso(
  Astro.locals.supabase,
  avisos.map((a) => a.id),
);

const completo = perfilCompleto(perfil);
const nombre = perfil?.nombre?.trim().split(' ')[0] ?? '';

// Resumen de actividad: lo que el usuario viene a mirar antes que sus datos.
const publicados = avisos.filter((a) => a.estado === 'publicado').length;
const vistas = avisos.reduce((total, a) => total + a.vistas, 0);
const contactos = [...revelaciones.values()].reduce((total, n) => total + n, 0);
const recientes = avisos.slice(0, 3);

// Estado de la cuenta. Antes eran dos banners permanentes encima del contenido,
// y un aviso que está siempre no es un aviso: es información. Su lugar es el
// módulo que resume la cuenta, junto a lo que habilita —publicar—, y no
// empujando el resto de la página fuera de la vista.
const estado = [
  usuario.emailConfirmado
    ? { listo: true, texto: 'Correo confirmado' }
    : { listo: false, texto: 'Confirma tu correo para poder publicar' },
  completo
    ? { listo: true, texto: 'Nombre y teléfono cargados' }
    : { listo: false, texto: 'Completa tu nombre y teléfono para poder publicar' },
];

// Las dos métricas subordinadas del bento; la dominante (avisos publicados) va
// dentro del módulo grande, junto al saludo.
const metricas = [
  { etiqueta: 'Vistas', valor: vistas.toLocaleString('es-CL'), nota: 'en todas tus publicaciones' },
  {
    etiqueta: 'Contactos revelados',
    valor: contactos.toLocaleString('es-CL'),
    nota: 'compradores que pidieron tu teléfono',
  },
];

const guardado = Astro.url.searchParams.has('guardado');
const mensajeError = mensajeDeError(Astro.url.searchParams.get('error'));

// Las anclas del rail apuntan acá: el margen de scroll deja el título libre de
// la barra fija en vez de que quede tapado al saltar.
const anclaCls = 'scroll-mt-24';
---

<Cuenta titulo="Mi cuenta" descripcion="Tu cuenta en CarFlip." usuario={usuario}>
  {mensajeError && <AvisoEstado tono="error">{mensajeError}</AvisoEstado>}
  {guardado && <Notificacion volver={Astro.url.pathname}>Datos guardados.</Notificacion>}

  <!-- Bento: un módulo dominante —saludo, avisos publicados, estado y el CTA
       del área— y dos subordinados con el rendimiento. -->
  <div class="grid gap-element lg:grid-cols-3 mb-block">
    <section class="bg-surface border border-line p-element lg:p-block lg:col-span-2 lg:row-span-2 flex flex-col">
      <h1 class="text-5xl sm:text-7xl text-ink leading-none text-balance">
        {nombre ? `Hola, ${nombre}.` : 'Hola.'}
      </h1>

      <p class="text-3xl text-ink tabular-nums leading-none mt-block">{publicados}</p>
      <p class="text-sm text-ink/70 uppercase tracking-wider mt-2">
        {publicados === 1 ? 'aviso publicado' : 'avisos publicados'}
      </p>

      <!-- El sobrante de alto del módulo lo absorbe la lista, no el botón: con
           `mt-auto` en el botón, un módulo sin espacio libre dejaba el CTA pegado
           al último ítem del estado. Así el aire de `mt-block` está garantizado y
           el CTA igual queda al pie cuando el módulo estira. -->
      <ul class="mt-element space-y-2 lg:mb-auto">
        {estado.map(({ listo, texto }) => (
          <li class="flex items-baseline gap-2 text-base text-ink">
            <span aria-hidden="true" class="text-ink/70">{listo ? '✓' : '→'}</span>
            {texto}
          </li>
        ))}
      </ul>

      <a href="/cuenta/avisos/nuevo" class={`${botonCls} self-start mt-block`}>
        Publicar un auto
        <span aria-hidden="true">→</span>
      </a>
    </section>

    {metricas.map(({ etiqueta, valor, nota }) => (
      <div class="bg-surface border border-line p-element">
        <p class="text-sm text-ink/70 uppercase tracking-wider">{etiqueta}</p>
        <p class="text-3xl text-ink tabular-nums leading-none mt-3">{valor}</p>
        <p class="text-sm text-ink/70 mt-2">{nota}</p>
      </div>
    ))}
  </div>

  <!-- Publicaciones recientes -->
  <section id="publicaciones" class={`mb-block ${anclaCls}`}>
    <div class="flex flex-wrap items-baseline justify-between gap-element mb-element">
      <h2 class="text-2xl text-ink">Tus publicaciones</h2>
      {avisos.length > 0 && (
        <a href="/cuenta/avisos" class={enlaceCls}>Ver las {avisos.length} →</a>
      )}
    </div>

    {avisos.length === 0 ? (
      <div class="bg-surface border border-line p-block">
        <p class="text-2xl text-ink mb-element">Todavía no publicaste ningún auto.</p>
        <p class="text-base text-ink/70 leading-relaxed max-w-xl">
          Publica el tuyo y aparecerá en el listado junto al resto de los avisos del sitio.
        </p>
      </div>
    ) : (
      <ul class="bg-surface border border-line divide-y divide-line">
        {recientes.map((aviso) => (
          <FilaAviso aviso={aviso} contactos={revelaciones.get(aviso.id) ?? 0}>
            {aviso.estado === 'publicado' && (
              <a href={`/auto/p/${aviso.id}`} class={enlaceCls}>Ver aviso</a>
            )}
          </FilaAviso>
        ))}
      </ul>
    )}
  </section>

  <!-- Datos de contacto. El formulario va sobre el plano de acento, igual que
       los de /cuenta/seguridad y los de sesión. -->
  <section id="datos" class={`mb-block max-w-3xl ${anclaCls}`}>
    <h2 class="text-2xl text-ink mb-element">Tus datos de contacto</h2>
    <p class="text-base text-ink/70 leading-relaxed mb-element">
      Tu teléfono solo lo ven los compradores que hayan iniciado sesión, y únicamente en tus
      publicaciones. Nunca aparece en el HTML público ni se comparte con terceros.
    </p>

    <form
      method="POST"
      action="/api/cuenta/perfil"
      class="bg-accent bloque-acento p-element space-y-element"
    >
      <div class="grid gap-element sm:grid-cols-2">
        <div>
          <label for="nombre" class={labelCls}>
            Nombre Completo<span class={requeridoCls}>*Requerido</span>
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            maxlength="100"
            pattern={PATRON.nombre}
            title="Solo letras y espacios, sin números ni signos."
            autocomplete="name"
            value={perfil?.nombre ?? ''}
            data-normaliza="texto"
            aria-describedby="err-nombre"
            class={`${campoCls} campo`}
          />
          <p id="err-nombre" class={errorCls}>
            Ingresa tu nombre: solo letras y espacios.
          </p>
        </div>

        <div>
          <label for="telefono" class={labelCls}>
            Teléfono <span class={requeridoCls}>*Requerido</span>
          </label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            required
            maxlength="20"
            pattern={PATRON.telefonoCL}
            title="Un móvil chileno: 9 seguido de 8 dígitos."
            autocomplete="tel"
            placeholder="+56 9 1234 5678"
            value={perfil?.telefono ?? ''}
            data-normaliza="telefono"
            aria-describedby="err-telefono"
            class={`${campoCls} campo tabular-nums`}
          />
          <p id="err-telefono" class={errorCls}>
            Ingresa un móvil chileno válido.
          </p>
        </div>

        <CamposUbicacion region={perfil?.region ?? undefined} comuna={perfil?.comuna ?? undefined} />
      </div>

      <button type="submit" class={botonCls}>
        Guardar datos
        <span aria-hidden="true">→</span>
      </button>
    </form>
  </section>

  <!-- Baja de cuenta. Va plegada: es la acción menos frecuente y la única
       irreversible, así que no compite por atención con el resto. Derecho de
       supresión (Ley 21.719). Sin diálogo de confirmación en JS: escribir la
       palabra es la barrera, y funciona sin JavaScript. -->
  <section class="max-w-3xl">
    <details class="desplegable group bg-surface border border-line open:border-ink hover:border-ink transition-colors duration-200">
      <summary class="flex items-start justify-between gap-element p-element cursor-pointer">
        <span class="text-base text-ink">Eliminar tu cuenta</span>
        <svg
          class="shrink-0 mt-1.5 transition-transform duration-200 group-open:rotate-45"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          stroke="currentColor"
          stroke-width="1"
          aria-hidden="true"
        >
          <path d="M0 8h16M8 0v16" />
        </svg>
      </summary>
      <div class="p-element pt-0">
        <p class="text-base text-ink/70 leading-relaxed mb-element">
          Se borran tu perfil, tus publicaciones, sus fotos y el registro de contactos revelados.
          Es inmediato y no se puede deshacer. Para confirmar, escribe {PALABRA_ELIMINAR}.
        </p>

        <form method="POST" action="/api/cuenta/eliminar" class="flex flex-wrap items-end gap-element">
          <div class="w-full sm:w-64">
            <label for="confirmacion" class="block text-base text-ink mb-2">Confirmación</label>
            <input
              type="text"
              id="confirmacion"
              name="confirmacion"
              required
              maxlength="20"
              autocomplete="off"
              pattern={PALABRA_ELIMINAR}
              title={`Escribe ${PALABRA_ELIMINAR} en mayúsculas.`}
              placeholder={PALABRA_ELIMINAR}
              aria-describedby="err-confirmacion"
              class={`${campoCls} campo`}
            />
            <p id="err-confirmacion" class={errorCls}>
              Escribe {PALABRA_ELIMINAR} en mayúsculas para confirmar.
            </p>
          </div>
          <button type="submit" class={botonPeligroCls}>Eliminar mi cuenta</button>
        </form>
      </div>
    </details>
  </section>

  <Normalizacion />
</Cuenta>
