---
import Base from '@layouts/Base.astro';
import { obtenerDatosMercado } from '@lib/db';
import { parsearFiltrosUrl } from '@lib/filtros';
import { formatearPrecio } from '@lib/formato';

const params  = Astro.url.searchParams;
const filtros = parsearFiltrosUrl(params);
const fuente  = filtros.fuente;

const datos = await obtenerDatosMercado(fuente);

const maxMarca  = datos.marcas[0]?.total  ?? 1;
const maxModelo = datos.modelos[0]?.total ?? 1;
const maxDist   = Math.max(...datos.distribucion.map(d => d.total), 1);

const fuentes = [
  { value: '',            label: 'Todas' },
  { value: 'autocosmos',  label: 'Autocosmos' },
  { value: 'yapo',        label: 'Yapo' },
];

// Clases compartidas por los cuatro paneles: el borde hairline es toda la estructura.
const panelCls   = 'border border-line';
const cabeceraCls = 'p-element border-b border-line';
const filaCls    = 'flex items-center gap-element p-element hover:bg-surface transition-colors';
const rankCls    = 'text-base text-muted w-6 shrink-0 tabular-nums text-right';
// `w-full overflow-hidden` es necesario: sin ancho explícito, el % de la barra
// interior queda indeterminado durante el sizing intrínseco y dispara el layout.
const pistaCls   = 'h-px w-full bg-line overflow-hidden';
---

<Base
  titulo="Mercado — Estadísticas de autos en Chile"
  descripcion="Precios promedio, marcas y modelos más listados en los portales de autos en Chile."
>

  <!-- Header -->
  <div class="mb-section">
    <p class="text-base text-muted uppercase tracking-widest mb-element">Análisis de precios</p>
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-element">Mercado</h1>
    <p class="text-base text-muted max-w-xl">
      Estadísticas calculadas sobre {datos.total.toLocaleString('es-CL')} avisos activos.
      Se actualizan a diario junto con el resto de los datos.
    </p>
  </div>

  <!-- Filtro de fuente -->
  <form method="GET" action="/mercado" class="mb-block">
    <fieldset class="flex flex-wrap items-center gap-element">
      <legend class="sr-only">Fuente</legend>
      <span class="text-sm text-muted uppercase tracking-wider shrink-0" aria-hidden="true">Fuente</span>
      <div class="flex flex-wrap gap-2">
        {fuentes.map(({ value, label }) => (
          <label class="cursor-pointer select-none shrink-0">
            <input
              type="radio"
              name="fuente"
              value={value}
              class="sr-only peer"
              checked={fuente === value || (!fuente && value === '')}
              onchange="this.form.submit()"
            />
            <span class="block px-3 py-2 text-base border border-line-strong text-muted peer-checked:bg-ink peer-checked:text-canvas peer-checked:border-ink peer-focus-visible:border-scarlet-signal hover:border-ink hover:text-ink transition-colors whitespace-nowrap">
              {label}
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  </form>

  <div class="grid grid-cols-1 xl:grid-cols-[1fr_380px] gap-element">

    <!-- Columna principal -->
    <div class="space-y-element">

      <!-- Marcas más listadas -->
      <section class={panelCls}>
        <div class={cabeceraCls}>
          <h2 class="text-base text-ink">Marcas más listadas</h2>
          <p class="text-base text-muted">Top 20 por cantidad de avisos</p>
        </div>
        <div class="divide-y divide-line">
          {datos.marcas.map((m, i) => (
            <div class={filaCls}>
              <span class={rankCls}>{i + 1}</span>

              <!-- Nombre + barra -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-2">
                  <a
                    href={`/marcas/${encodeURIComponent(m.marca)}`}
                    class="text-base text-ink hover:text-muted transition-colors truncate"
                  >
                    {m.marca}
                  </a>
                  <span class="text-base text-muted tabular-nums ml-3 shrink-0">
                    {m.total.toLocaleString('es-CL')}
                  </span>
                </div>
                <div class={pistaCls}>
                  <div
                    class="h-full bg-ink"
                    style={`width: ${(m.total / maxMarca * 100).toFixed(1)}%`}
                  />
                </div>
              </div>

              <!-- Precio promedio -->
              <span class="text-base tabular-nums text-muted w-28 text-right shrink-0 hidden sm:block">
                {m.precio_promedio ? formatearPrecio(Math.round(m.precio_promedio)) : '—'}
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- Modelos más listados -->
      <section class={panelCls}>
        <div class={cabeceraCls}>
          <h2 class="text-base text-ink">Modelos más listados</h2>
          <p class="text-base text-muted">Top 15 por cantidad de avisos</p>
        </div>
        <div class="divide-y divide-line">
          {datos.modelos.map((m, i) => (
            <div class={filaCls}>
              <span class={rankCls}>{i + 1}</span>

              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-2">
                  <div class="min-w-0">
                    <a
                      href={`/avisos?marca=${encodeURIComponent(m.marca)}&modelo=${encodeURIComponent(m.modelo)}`}
                      class="text-base text-ink hover:text-muted transition-colors"
                    >
                      {m.modelo}
                    </a>
                    <span class="text-base text-muted ml-2">{m.marca}</span>
                  </div>
                  <span class="text-base text-muted tabular-nums ml-3 shrink-0">
                    {m.total.toLocaleString('es-CL')}
                  </span>
                </div>
                <div class={pistaCls}>
                  <div
                    class="h-full bg-muted"
                    style={`width: ${(m.total / maxModelo * 100).toFixed(1)}%`}
                  />
                </div>
              </div>

              <span class="text-base tabular-nums text-muted w-28 text-right shrink-0 hidden sm:block">
                {m.precio_promedio ? formatearPrecio(Math.round(m.precio_promedio)) : '—'}
              </span>
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- Columna lateral -->
    <div class="space-y-element">

      <!-- Distribución de precios -->
      <section class={panelCls}>
        <div class={cabeceraCls}>
          <h2 class="text-base text-ink">Distribución de precios</h2>
          <p class="text-base text-muted">Avisos por rango</p>
        </div>
        <div class="p-element space-y-element">
          {datos.distribucion.map(d => (
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-base text-ink">{d.etiqueta}</span>
                <span class="text-base tabular-nums text-muted">
                  {d.total.toLocaleString('es-CL')}
                </span>
              </div>
              <div class={pistaCls}>
                <div
                  class="h-full bg-ink"
                  style={`width: ${d.total > 0 ? (d.total / maxDist * 100).toFixed(1) : 0}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Tabla de marcas: rango de precios -->
      <section class={panelCls}>
        <div class={cabeceraCls}>
          <h2 class="text-base text-ink">Rango de precios por marca</h2>
          <p class="text-base text-muted">Mínimo y máximo publicados</p>
        </div>
        <div class="divide-y divide-line max-h-96 overflow-y-auto">
          {datos.marcas.filter(m => m.precio_minimo && m.precio_maximo).map(m => (
            <div class="p-element">
              <div class="flex items-center justify-between mb-1">
                <span class="text-base text-ink">{m.marca}</span>
                <span class="text-base text-muted tabular-nums">{m.total} avisos</span>
              </div>
              <div class="flex items-center gap-2 text-base tabular-nums">
                <span class="text-muted">{formatearPrecio(Math.round(m.precio_minimo!))}</span>
                <span class="flex-1 border-t border-line border-dashed mx-1" />
                <span class="text-muted">{formatearPrecio(Math.round(m.precio_maximo!))}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>

</Base>
