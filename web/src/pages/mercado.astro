---
import Base from '@layouts/Base.astro';
import Normalizacion from '@components/Normalizacion.astro';
import Panel from '@components/mercado/Panel.astro';
import KpiSignal from '@components/mercado/KpiSignal.astro';
import Treemap from '@components/mercado/Treemap.astro';
import Histograma from '@components/mercado/Histograma.astro';
import BandaPrecioAnio from '@components/mercado/BandaPrecioAnio.astro';
import MixCombustible from '@components/mercado/MixCombustible.astro';
import RangoDumbbell from '@components/mercado/RangoDumbbell.astro';
import TendenciaMercado from '@components/mercado/TendenciaMercado.astro';
import ConsultaMercado from '@components/mercado/ConsultaMercado.astro';
import { obtenerDatosMercado, obtenerHistoriaMercado, consultarMercado } from '@lib/db';
import { aEntero } from '@lib/campos';
import { formatearPrecio } from '@lib/formato';

const params = Astro.url.searchParams;

// Consultor de precios: parámetros propios (q_*) para no chocar con el filtro
// del tablero. Se validan y acotan antes de llegar a la consulta.
const anioActual = new Date().getFullYear();
const qMarca  = params.get('q_marca')?.trim().slice(0, 100) ?? '';
const qModelo = params.get('q_modelo')?.trim().slice(0, 100) ?? '';
const qAnioN  = aEntero(params.get('q_anio'));
const qAnio   = qAnioN !== null && qAnioN >= 1950 && qAnioN <= anioActual + 1 ? qAnioN : null;
const qPrecioN = aEntero(params.get('q_precio'));
const qPrecio  = qPrecioN !== null && qPrecioN > 0 ? qPrecioN : null;
const consulta = { marca: qMarca, modelo: qModelo, anio: qAnio, precio: qPrecio };

// `datos` se calcula sobre los avisos vigentes; `historia` es la serie diaria
// que persiste `carflip snapshot`, una fila por día.
const [datos, historia, resultadoConsulta] = await Promise.all([
  obtenerDatosMercado(),
  obtenerHistoriaMercado(30),
  qMarca && qModelo && qAnio ? consultarMercado(qMarca, qModelo, qAnio) : Promise.resolve(null),
]);

const serieNuevos = datos.nuevosPorDia.map((d) => d.total);
const kpi = (n: number | null) => (n != null ? formatearPrecio(Math.round(n)) : '—');
---

<Base
  titulo="Estadísticas de Mercado"
  descripcion="Precios, marcas, modelos y tendencias del mercado de autos usados en Chile: distribución de precios, depreciación por año, kilometraje y combustible."
>

  <!-- Header -->
  <div class="mb-block">
    <p class="text-base text-muted uppercase tracking-widest mb-element">Análisis de precios</p>
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-element">Mercado</h1>
    <p class="text-base text-muted max-w-xl">
      Estadísticas calculadas sobre {datos.total.toLocaleString('es-CL')} avisos activos.
      Se actualizan a diario junto con el resto de los datos.
    </p>
  </div>

  <!-- Consultor de precios -->
  <div class="mb-block">
    <ConsultaMercado
      marcas={datos.marcasTodas}
      modelos={datos.modelosTodos}
      anios={datos.aniosTodos}
      consulta={consulta}
      resultado={resultadoConsulta}
    />
  </div>

  <!-- Tira de KPIs -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-element mb-element">
    <KpiSignal etiqueta="Avisos activos" valor={datos.total.toLocaleString('es-CL')} nota="en total" />
    <KpiSignal etiqueta="Precio mediano" valor={kpi(datos.precio_mediano)} nota="mediana del mercado" />
    <KpiSignal etiqueta="Precio promedio" valor={kpi(datos.precio_promedio)} nota="media aritmética" />
    <KpiSignal etiqueta="Nuevos" valor={datos.nuevos_24h.toLocaleString('es-CL')} nota="últimas 24 h" serie={serieNuevos} />
    <KpiSignal etiqueta="Con rebaja" valor={datos.con_baja.toLocaleString('es-CL')} nota="▼ bajaron de precio" />
  </div>

  <!-- Bento de gráficos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-element">

    <Panel titulo="Marcas más listadas" subtitulo="Área proporcional a la cantidad de avisos" class="lg:col-span-4">
      {datos.marcas.length > 0
        ? <Treemap marcas={datos.marcas} titulo="Marcas más listadas" />
        : <p class="p-element text-sm text-muted">Todavía no hay avisos con marca para graficar.</p>}
    </Panel>

    <Panel titulo="Modelos más listados" subtitulo="Top 15 por cantidad" class="lg:col-span-2">
      <div class="divide-y divide-line">
        {datos.modelos.map((m, i) => (
          <div class="flex items-center gap-element p-element hover:bg-canvas transition-colors">
            <span class="text-base w-6 shrink-0 tabular-nums text-right text-muted">{i + 1}</span>
            <a
              href={`/avisos?marca=${encodeURIComponent(m.marca)}&modelo=${encodeURIComponent(m.modelo)}`}
              class="text-base text-ink hover:text-muted transition-colors truncate min-w-0 flex-1"
            >
              {m.modelo}<span class="text-muted ml-2 text-sm">{m.marca}</span>
            </a>
            <span class="text-base text-muted tabular-nums shrink-0">{m.total.toLocaleString('es-CL')}</span>
          </div>
        ))}
      </div>
    </Panel>

    <Panel titulo="Distribución de precios" subtitulo="Avisos por tramo de precio" class="lg:col-span-3">
      <Histograma buckets={datos.histogramaPrecio} unidad="precio" titulo="Distribución de precios" />
    </Panel>

    <Panel titulo="Precio por año" subtitulo="Mediana y banda p25–p75 · depreciación" class="lg:col-span-3">
      {datos.precioPorAnio.length >= 2
        ? <BandaPrecioAnio datos={datos.precioPorAnio} />
        : <p class="p-element text-sm text-muted">Datos insuficientes para la curva por año.</p>}
    </Panel>

    <Panel titulo="Combustible" subtitulo="Mix del mercado" class="lg:col-span-2">
      {datos.mixCombustible.length > 0
        ? <MixCombustible datos={datos.mixCombustible} />
        : <p class="p-element text-sm text-muted">Todavía no hay avisos con combustible declarado.</p>}
    </Panel>

    <Panel titulo="Distribución de kilometraje" subtitulo="Avisos por tramo de km" class="lg:col-span-2">
      <Histograma buckets={datos.histogramaKm} unidad="km" titulo="Distribución de kilometraje" />
    </Panel>

    <Panel titulo="Rango de precios por marca" subtitulo="Mínimo · mediana · máximo" class="lg:col-span-2">
      <RangoDumbbell marcas={datos.marcas} />
    </Panel>

    <Panel titulo="Tendencia del mercado" subtitulo="Mediana de precio por día · mercado total" class="lg:col-span-6">
      <TendenciaMercado serie={historia} />
    </Panel>

  </div>

  <Normalizacion />
</Base>
