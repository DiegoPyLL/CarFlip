---
import CtaContacto from '@components/avisos/CtaContacto.astro';
import GaleriaFotos from '@components/avisos/GaleriaFotos.astro';
import PatenteChilena from '@components/avisos/PatenteChilena.astro';
import PosicionMercado from '@components/avisos/PosicionMercado.astro';
import IconoTraccion from '@components/filtros/IconoTraccion.astro';
import Base from '@layouts/Base.astro';
import { urlEntrar } from '@lib/auth/servidor';
import { volverAlListado } from '@lib/enlaces';
import { formatearFecha, formatearKm, formatearPrecio, signosDelta } from '@lib/formato';
import { scriptJsonLd } from '@lib/jsonLd';
import { resolverUrlImagen } from '@lib/cdn';
import { contactoRevelado, obtenerAvisoPublico } from '@lib/publicaciones/consultas';
import { LIMITES, mensajeDeError } from '@lib/publicaciones/limites';
import { MOTIVOS_REPORTE } from '@lib/publicaciones/opciones';

// El parámetro admite un sufijo de slug (`123-toyota-yaris-2018`) para poder
// compartir una URL legible; `parseInt` se queda con el id y la canónica
// siempre apunta a la forma corta, así que no hay contenido duplicado.
const idNum = parseInt(Astro.params.id ?? '', 10);
if (!Number.isInteger(idNum)) return Astro.rewrite('/404');

// Solo los avisos publicados existen aquí: uno pausado, vendido o eliminado
// responde 404, que es lo que corresponde para una URL que estuvo indexada.
const aviso = await obtenerAvisoPublico(idNum);
if (!aviso) return Astro.rewrite('/404');

const usuario = Astro.locals.usuario;
const supabase = Astro.locals.supabase;
const ruta = `/auto/p/${aviso.id}`;
const urlAbsoluta = new URL(ruta, Astro.site ?? Astro.url.origin).href;

// El teléfono se pinta a quien ya lo pidió para este aviso: recargar, volver
// desde el listado o compartirse el enlace consigo mismo no gasta cupo, se paga
// una vez por aviso. La primera vez hace falta un clic, que va por POST
// (`/api/publicacion/[id]/contacto`): esta página es un GET y registrar acá
// permitía que un sitio externo agotara el cupo del día de cualquiera con sesión.
// El visitante anónimo —todo el tráfico indexable— no paga ninguna consulta
// extra, y el número no llega siquiera al HTML que ve un rastreador.
const revelacion = usuario && supabase ? await contactoRevelado(supabase, aviso.id, usuario.id) : null;
const contacto = revelacion?.estado === 'ok' ? revelacion.contacto : null;

// Un documento con un teléfono dentro no debe quedar en ninguna caché
// compartida: la misma URL le responde otra cosa a cada sesión.
if (contacto) Astro.response.headers.set('Cache-Control', 'private, no-store');

// El enlace lleva la URL del aviso en el texto: el vendedor recibe el mensaje
// en su teléfono sabiendo de cuál de sus autos le hablan.
const textoWhatsapp = encodeURIComponent(
  `Hola, vi tu ${aviso.titulo} en CarFlip (${urlAbsoluta}). ¿Sigue disponible?`,
);

// El destino de vuelta depende del `Referer`, así que la misma URL no sirve la
// misma respuesta a todo el mundo: sin `Vary` una caché compartida podría dar el
// listado de otro visitante.
Astro.response.headers.append('Vary', 'Referer');
const volver = volverAlListado(Astro.request.headers.get('referer'), Astro.url.origin);
const mensajeError = mensajeDeError(Astro.url.searchParams.get('error'));
const reportado = Astro.url.searchParams.has('reportado');

// El único estado con sesión en el que no hay nada que pedir. El tope diario y los
// fallos del registro llegan como `?error=` desde el POST y los pinta
// `mensajeError`, que es el mismo camino que el resto de los avisos de la página.
const avisoSinContacto =
  revelacion?.estado === 'sin_telefono' ? 'Este vendedor todavía no ha cargado su teléfono.' : null;

const delta = signosDelta(aviso.delta_pct);
// Solo fotos de los orígenes que la CSP admite: una fila insertada directo por
// PostgREST podría apuntar a un pixel externo, que el navegador bloquearía
// dejando el hueco en la galería.
const fotos = aviso.fotos.filter((f) => resolverUrlImagen(f.url) !== null);
const portada = fotos[0]?.url ?? resolverUrlImagen(aviso.url_imagen);

const descripcionPage = [
  aviso.titulo,
  aviso.precio ? formatearPrecio(aviso.precio, aviso.moneda) : 'Precio a consultar',
  aviso.km !== null ? formatearKm(aviso.km) : null,
  aviso.ubicacion,
  'Publicado por un particular en CarFlip.',
]
  .filter(Boolean)
  .join(' · ');

const ficha = [
  { label: 'Marca', valor: aviso.marca },
  { label: 'Modelo', valor: aviso.modelo },
  { label: 'Versión', valor: aviso.version },
  { label: 'Año', valor: aviso.anio ? String(aviso.anio) : null },
  { label: 'Kilometraje', valor: aviso.km !== null ? formatearKm(aviso.km) : null },
  { label: 'Combustible', valor: aviso.combustible },
  { label: 'Transmisión', valor: aviso.transmision },
  { label: 'Tracción', valor: aviso.traccion, icono: true },
  { label: 'Ubicación', valor: aviso.ubicacion },
].filter((f) => f.valor);

// `seller` va sin nombre ni teléfono a propósito: el contacto solo se revela
// con sesión, y el JSON-LD es la parte más fácil de raspar de la página.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: aviso.titulo,
  brand: aviso.marca ? { '@type': 'Brand', name: aviso.marca } : undefined,
  model: aviso.modelo ?? undefined,
  modelDate: aviso.anio ?? undefined,
  vehicleTransmission: aviso.transmision ?? undefined,
  driveWheelConfiguration: aviso.traccion ?? undefined,
  mileageFromOdometer: aviso.km !== null ? { '@type': 'QuantitativeValue', value: aviso.km, unitCode: 'KMT' } : undefined,
  fuelType: aviso.combustible ?? undefined,
  image: fotos.length ? fotos.map((f) => f.url) : undefined,
  description: aviso.descripcion ?? undefined,
  offers: aviso.precio
    ? {
        '@type': 'Offer',
        price: aviso.precio,
        priceCurrency: aviso.moneda,
        url: urlAbsoluta,
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/UsedCondition',
        seller: { '@type': 'Person' },
      }
    : undefined,
};

const botonCls =
  'inline-flex items-center gap-2 text-base text-ink border border-ink px-6 py-3 hover:bg-ink hover:text-canvas transition-colors duration-150 cursor-pointer';
const campoCls =
  'w-full bg-field border border-line-strong px-4 py-2.5 text-base text-ink focus:outline-hidden focus:border-scarlet-signal transition-colors duration-150';
---

<Base
  titulo={`${aviso.titulo} — CarFlip`}
  descripcion={descripcionPage}
  urlCanonica={ruta}
  urlImagen={portada ?? undefined}
  tipo="product"
>
  <script is:inline nonce={Astro.locals.nonce} slot="head" type="application/ld+json" set:html={scriptJsonLd(jsonLd)} />

  <div class="max-w-7xl mx-auto">
    <a
      href={volver}
      class="inline-flex items-center gap-2 text-base hover:text-ink mb-element transition-colors duration-150"
    >
      <span aria-hidden="true">←</span>
      Volver a avisos
    </a>

    <!-- Cabecera en dos columnas: galería a la izquierda, todo lo que decide la
         compra a la derecha, para que la pantalla completa quepa arriba. Bajo md
         se apila, con las fotos primero. Desde lg la foto se lleva 3/5 del
         ancho, y la columna de datos sigue holgada para el precio a 5xl. -->
    <div class="grid md:grid-cols-2 lg:grid-cols-[3fr_2fr] gap-block items-start">

      <!-- `min-w-0` evita que el carrusel ensanche su columna del grid. -->
      <div class="min-w-0">
      {fotos.length > 0 ? (
        <GaleriaFotos fotos={fotos} titulo={aviso.titulo} />
      ) : (
        <div class="aspect-[4/3] bg-surface flex items-center justify-center text-base">Sin fotos</div>
      )}

      {aviso.patente && (
        <div class="mt-element flex justify-center">
          <PatenteChilena patente={aviso.patente} />
        </div>
      )}
      </div>

      <div>
        <div class="flex flex-wrap gap-2 mb-element">
          <span class="text-base px-3 py-1 border border-line">Particular</span>
          {delta && (
            <span class={`text-base px-3 py-1 border border-line tabular-nums ${delta.clases}`}>{delta.texto}</span>
          )}
        </div>

        <h1 class="text-xl sm:text-2xl leading-snug mb-element">{aviso.titulo}</h1>

        <!-- El display baja de 7xl a 5xl: en media pantalla, catorce dígitos a
             7xl desbordan la columna. -->
        <div class="flex flex-wrap items-baseline gap-element mb-element pb-element border-b border-line">
          <span class="text-4xl sm:text-5xl text-ink tabular-nums leading-none">
            {aviso.precio ? formatearPrecio(aviso.precio, aviso.moneda) : 'Precio a consultar'}
          </span>
          {aviso.precio_anterior && delta && (
            <span class="text-base line-through tabular-nums">
              {formatearPrecio(aviso.precio_anterior, aviso.moneda)}
            </span>
          )}
        </div>

        <dl class="grid grid-cols-2 gap-x-element gap-y-element mb-element">
          {ficha.map(({ label, valor, icono }) => (
            <div>
              <dt class="text-base">{label}</dt>
              <dd class="text-base text-ink flex items-center gap-2">
                {icono && valor && <IconoTraccion traccion={valor} size={20} />}
                {valor}
              </dd>
            </div>
          ))}
        </dl>

        <!-- Primera de las tres apariciones del contacto: con sesión baja al
             bloque, sin ella lleva a entrar. Un anónimo no llega a pensar que
             el botón le va a dar el número. -->
        <a href={usuario ? '#contacto' : urlEntrar(ruta)} rel={usuario ? undefined : 'nofollow'} class={botonCls}>
          <span aria-hidden="true">→</span>
          {usuario ? 'Ver teléfono y WhatsApp' : 'Inicia sesión para ver el teléfono'}
        </a>

        <div class="text-sm space-y-1 mt-element">
          <p>Publicado: <span class="text-ink">{formatearFecha(new Date(aviso.publicado_en))}</span></p>
          <p>Última actualización: <span class="text-ink">{formatearFecha(new Date(aviso.actualizado_en))}</span></p>
        </div>
      </div>
    </div>

    <PosicionMercado marca={aviso.marca} modelo={aviso.modelo} anio={aviso.anio} precio={aviso.precio} />

    {aviso.descripcion && (
      <div class="mt-section pt-block border-t border-line">
        <h2 class="text-base uppercase tracking-wider mb-element">Descripción</h2>
        <p class="text-base text-ink whitespace-pre-line leading-relaxed max-w-2xl">{aviso.descripcion}</p>
      </div>
    )}

    <!-- Contacto: el teléfono lo pinta el servidor a cualquier lector con
         sesión. Sin sesión no está en el HTML, ni siquiera oculto. -->
    <section id="contacto" class="mt-section pt-block border-t border-line scroll-mt-16">
      <h2 class="text-base uppercase tracking-wider mb-element">Contacto</h2>

      {mensajeError && (
        <div class="mb-element px-6 py-2.5 border border-scarlet-signal text-base text-ink" role="alert">
          {mensajeError}
        </div>
      )}

      {reportado && (
        <div class="mb-element px-6 py-2.5 border border-line-strong text-base text-ink" role="status">
          Gracias. Revisaremos esta publicación.
        </div>
      )}

      {contacto ? (
        <div class="max-w-md">
          <p class="text-2xl text-ink">{contacto.nombre ?? 'Vendedor particular'}</p>
          <!-- El número mide 14 caracteres: a text-5xl se sale de una pantalla
               de 320px, así que escala recién en sm. -->
          <p class="text-3xl sm:text-5xl text-ink tabular-nums leading-none mt-element">{contacto.telefono}</p>
          <!-- WhatsApp va primero: es el canal por el que de verdad se
               contesta, y el enlace llega con el mensaje ya escrito. -->
          <div class="flex flex-wrap gap-element mt-block">
            <a
              href={`${contacto.whatsapp}?text=${textoWhatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class={botonCls}
            >
              <span aria-hidden="true">→</span>
              Escribir por WhatsApp
            </a>
            <a href={contacto.tel} class={botonCls}>Llamar</a>
          </div>
          <p class="text-base leading-relaxed mt-element">
            El mensaje se envía con el aviso al que se refiere. El vendedor ve cuántas personas
            pidieron su contacto.
          </p>
        </div>
      ) : (
        <div class="max-w-md">
          <p class="text-2xl text-ink">Vendedor particular</p>

          <!-- La máscara no lleva un solo dígito real: está para mostrar qué es
               exactamente lo que falta, en el tamaño en que va a aparecer. Con
               un vendedor sin teléfono cargado no hay nada que enmascarar. -->
          {revelacion?.estado !== 'sin_telefono' && (
            <p class="text-3xl sm:text-5xl tabular-nums leading-none mt-element" aria-hidden="true">
              +56 9 •••• ••••
            </p>
          )}

          {avisoSinContacto && (
            <div class="mt-block px-6 py-2.5 border border-scarlet-signal text-base text-ink leading-relaxed" role="alert">
              {avisoSinContacto}
            </div>
          )}

          <!-- Con sesión, el número está a un clic: el envío va por POST porque
               registra la revelación y gasta cupo del día. Es un formulario
               nativo, sin JavaScript, y una vez revelado el aviso ya no vuelve
               a aparecer. -->
          {revelacion?.estado === 'pendiente' && (
            <form method="POST" action={`/api/publicacion/${aviso.id}/contacto`} class="mt-block">
              <button type="submit" class={botonCls}>
                <span aria-hidden="true">→</span>
                Ver teléfono y WhatsApp
              </button>
              <p class="text-base leading-relaxed mt-element">
                El vendedor ve cuántas personas pidieron su contacto. Puedes ver hasta
                {' '}{LIMITES.revelacionesPorDia} teléfonos al día.
              </p>
            </form>
          )}

          {!usuario && (
            <div class="mt-block">
              <CtaContacto
                ruta={ruta}
                titulo="El teléfono y el WhatsApp de este vendedor están a un clic."
                detalle="Pedimos sesión para que los números de quienes publican no terminen en manos de un robot."
              />
            </div>
          )}
        </div>
      )}

      <details class="mt-block">
        <summary class="text-base underline underline-offset-4 hover:text-ink transition-colors duration-150 cursor-pointer">
          Reportar publicación
        </summary>
        <form
          method="POST"
          action={`/api/publicacion/${aviso.id}/reportar`}
          class="mt-element max-w-md space-y-element"
        >
          <input type="hidden" name="volver" value={ruta} />
          <div>
            <label for="motivo" class="block text-base text-ink mb-2">Motivo</label>
            <select id="motivo" name="motivo" required class={campoCls}>
              {MOTIVOS_REPORTE.map((m) => <option value={m}>{m}</option>)}
            </select>
          </div>
          <div>
            <label for="detalle" class="block text-base text-ink mb-2">Detalle (opcional)</label>
            <textarea id="detalle" name="detalle" rows="3" maxlength="1000" class={campoCls}></textarea>
          </div>
          <button type="submit" class={botonCls}>Enviar reporte</button>
        </form>
      </details>
    </section>

    <!-- Tercera y última insistencia, para quien llegó al final del aviso sin
         sesión: el bloque de contacto ya quedó arriba, fuera de pantalla. -->
    {!usuario && (
      <div class="mt-section pt-block border-t border-line">
        <CtaContacto
          ruta={ruta}
          titulo="Este auto lo vende un particular: con la sesión abierta ves su teléfono aquí mismo."
          detalle="Hablas directo con el dueño del auto, sin intermediarios."
        />
      </div>
    )}
  </div>
</Base>
