---
import PosicionMercado from '@components/avisos/PosicionMercado.astro';
import IconoTraccion from '@components/filtros/IconoTraccion.astro';
import Base from '@layouts/Base.astro';
import { resolverUrlImagen } from '@lib/cdn';
import { obtenerAviso } from '@lib/db';
import { parsearRefAviso } from '@lib/enlaces';
import { formatearPrecio, formatearKm, formatearFecha, signosDelta } from '@lib/formato';
import { scriptJsonLd } from '@lib/jsonLd';

// El parámetro es el par `fuente-id` (`yapo-757`): el id solo no alcanza,
// porque cada tabla tiene su propia secuencia y lo repite.
const ref = parsearRefAviso(Astro.params.id ?? '');
if (!ref) return Astro.rewrite('/404');

const aviso = await obtenerAviso(ref.fuente, ref.id);
if (!aviso) return Astro.rewrite('/404');

const ruta = `/auto/${ref.fuente}-${ref.id}`;

const backRaw = Astro.url.searchParams.get('back') ?? '/';
const urlVolver = backRaw.startsWith('/') && !backRaw.startsWith('//') ? backRaw : '/';

const delta      = signosDelta(aviso.delta_pct);
const urlImagen  = resolverUrlImagen(aviso.url_imagen);
const titulo     = [aviso.marca, aviso.modelo, aviso.anio].filter(Boolean).join(' ') || aviso.titulo;
const descripcionPage = `${titulo} — ${aviso.precio ? formatearPrecio(aviso.precio, aviso.moneda) : 'Precio a consultar'}. ${aviso.km ? formatearKm(aviso.km) : ''} ${aviso.ubicacion ?? ''}`.trim();

const fuenteLabels: Record<string, string> = {
  autocosmos: 'Autocosmos.cl',
  yapo: 'Yapo.cl',
  autosusados: 'Autosusados.cl',
  checkeados: 'Checkeados.cl',
  particular: 'Particular',
};
const fuenteLabel = fuenteLabels[aviso.fuente] || aviso.fuente.toUpperCase();

const ficha = [
  { label: 'Marca',       valor: aviso.marca },
  { label: 'Modelo',      valor: aviso.modelo },
  { label: 'Año',         valor: aviso.anio ? String(aviso.anio) : null },
  { label: 'Kilometraje', valor: aviso.km !== null ? formatearKm(aviso.km) : null },
  { label: 'Combustible', valor: aviso.combustible },
  { label: 'Transmisión', valor: aviso.transmision },
  { label: 'Tracción',    valor: aviso.traccion, icono: true },
  { label: 'Ubicación',   valor: aviso.ubicacion },
].filter(f => f.valor);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: aviso.titulo,
  brand: aviso.marca ? { '@type': 'Brand', name: aviso.marca } : undefined,
  model: aviso.modelo ?? undefined,
  modelDate: aviso.anio ?? undefined,
  mileageFromOdometer: aviso.km ? { '@type': 'QuantitativeValue', value: aviso.km, unitCode: 'KMT' } : undefined,
  fuelType: aviso.combustible ?? undefined,
  vehicleTransmission: aviso.transmision ?? undefined,
  driveWheelConfiguration: aviso.traccion ?? undefined,
  offers: aviso.precio ? { '@type': 'Offer', price: aviso.precio, priceCurrency: aviso.moneda, url: aviso.url } : undefined,
  image: urlImagen ?? undefined,
  description: aviso.descripcion ?? undefined,
};
---

<Base
  titulo={`${titulo} — CarFlip`}
  descripcion={descripcionPage}
  urlCanonica={ruta}
  urlImagen={urlImagen ?? undefined}
  tipo="product"
>
  <script is:inline nonce={Astro.locals.nonce} slot="head" type="application/ld+json" set:html={scriptJsonLd(jsonLd)} />

  <div class="max-w-6xl mx-auto">

    <!-- Volver -->
    <a
      href={urlVolver}
      class="inline-flex items-center gap-2 text-base  hover:text-ink mb-element transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Volver a avisos
    </a>

    <!-- Cabecera: foto a la izquierda, todo lo que decide la compra a la
         derecha. En una columna la foto ya empujaba el precio y la ficha bajo el
         fold; en dos, la pantalla completa cabe arriba. Bajo md vuelve a
         apilarse, con la foto primero. -->
    <div class="grid md:grid-cols-2 gap-block items-start">

      <!-- Imagen: obra a sangre, sin radio ni recorte -->
      {urlImagen ? (
        <img
          src={urlImagen}
          alt={aviso.titulo}
          width={900}
          height={506}
          loading="eager"
          fetchpriority="high"
          class="w-full aspect-[16/9] object-cover bg-surface"
        />
      ) : (
        <div class="aspect-[16/9] bg-surface flex items-center justify-center  text-base">
          Sin imagen
        </div>
      )}

      <div>

        <!-- Badges -->
        <div class="flex flex-wrap gap-2 mb-element">
          <span class="text-base px-3 py-1  border border-line">
            {fuenteLabel}
          </span>
          {delta && (
            <span class={`text-base px-3 py-1 border border-line tabular-nums ${delta.clases}`}>
              {delta.texto}
            </span>
          )}
          {aviso.disponible === false && (
            <span class="text-base px-3 py-1  border border-line line-through">
              No disponible
            </span>
          )}
        </div>

        <!-- Título y precio -->
        <!-- El título es subtítulo; el precio es el display. Separarlos evita que
             compitan, sobre todo cuando el título del portal ya incluye el precio.
             El display baja de 7xl a 5xl: en media pantalla, catorce dígitos a
             7xl desbordan la columna. -->
        <h1 class="text-xl sm:text-2xl  leading-snug mb-element">
          {aviso.titulo}
        </h1>

        <div class="flex flex-wrap items-baseline gap-element mb-element pb-element border-b border-line">
          <span class="text-4xl sm:text-5xl text-ink tabular-nums leading-none">
            {aviso.precio ? formatearPrecio(aviso.precio, aviso.moneda) : 'Precio a consultar'}
          </span>
          {aviso.precio_anterior && delta && (
            <span class="text-base  line-through tabular-nums">
              {formatearPrecio(aviso.precio_anterior, aviso.moneda)}
            </span>
          )}
        </div>

        <!-- Ficha técnica: pares label/valor apilados, sin cajas -->
        <dl class="grid grid-cols-2 gap-x-element gap-y-element mb-element">
          {ficha.map(({ label, valor, icono }) => (
            <div>
              <dt class="text-base ">{label}</dt>
              <dd class="text-base text-ink flex items-center gap-2">
                {icono && valor && <IconoTraccion traccion={valor} size={20} />}
                {valor}
              </dd>
            </div>
          ))}
        </dl>

        <!-- CTA + fechas: el punto escarlata es el único color de esta pantalla -->
        <a
          href={aviso.url}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-2 text-base text-ink border border-ink px-6 py-3 hover:bg-ink hover:text-canvas transition-colors duration-150"
        >
          <span class="w-1.5 h-1.5 bg-scarlet-signal shrink-0" aria-hidden="true"></span>
          Ver aviso original
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>

        <div class="text-sm  space-y-1 mt-element">
          {aviso.primera_vez_visto && (
            <p>Visto por primera vez: <span class="text-ink">{formatearFecha(aviso.primera_vez_visto)}</span></p>
          )}
          {aviso.ultima_vez_visto && (
            <p>Última actualización: <span class="text-ink">{formatearFecha(aviso.ultima_vez_visto)}</span></p>
          )}
        </div>
      </div>
    </div>

    <PosicionMercado marca={aviso.marca} modelo={aviso.modelo} anio={aviso.anio} precio={aviso.precio} />

    <!-- Descripción -->
    {aviso.descripcion && (
      <div class="mt-section pt-block border-t border-line">
        <h2 class="text-base  uppercase tracking-wider mb-element">Descripción</h2>
        <p class="text-base text-ink whitespace-pre-line leading-relaxed max-w-2xl">
          {aviso.descripcion}
        </p>
      </div>
    )}
  </div>
</Base>
