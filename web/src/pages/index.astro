---
import Base from '@layouts/Base.astro';
import CardDeal from '@components/deals/CardDeal.astro';
import Normalizacion from '@components/Normalizacion.astro';
import BuscadorHome from '@components/marketing/BuscadorHome.astro';
import { obtenerDeals, obtenerEstadisticas, obtenerFiltrosDisponibles } from '@lib/db';
import { formatearFecha } from '@lib/formato';
import { parrafoCls } from '@lib/marketing';
import { scriptJsonLd } from '@lib/jsonLd';
import { RESPONSABLE } from '@lib/legal';

// Antes `/` era el listado: los enlaces y backlinks con filtros siguen llegando
// aquí. Se preservan redirigiendo a /avisos con los mismos parámetros.
if (Astro.url.search) {
  return Astro.redirect('/avisos' + Astro.url.search, 301);
}

// Las tres en paralelo: `obtenerEstadisticas` pagina todas las filas del catálogo
// y domina el tiempo, así que las opciones del buscador no cuestan TTFB.
const [estadisticas, destacados, disponibles] = await Promise.all([
  obtenerEstadisticas(),
  obtenerDeals({}, 10),
  obtenerFiltrosDisponibles(),
]);

// El origen sale de `site` (carflip.cl) y no del host: los deploys de preview no
// deben declarar su propia URL como buscador del sitio.
const origen = Astro.site?.origin ?? Astro.url.origin;

// Declara el buscador de la portada para los rastreadores: `modelo` es el mismo
// parámetro que consume /avisos. El `publisher` va como `Person` y no como
// `Organization` porque detrás de CarFlip no hay sociedad: los datos salen de
// `@lib/legal`, los mismos que muestran /legal y /privacidad.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CarFlip',
  url: origen,
  inLanguage: 'es-CL',
  publisher: {
    '@type': 'Person',
    name: RESPONSABLE.nombre,
    email: RESPONSABLE.correo,
    sameAs: [RESPONSABLE.perfil],
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${origen}/avisos?modelo={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// Se lee acá y no dentro del atributo del `<script slot="head">`: cuando `Astro`
// se usa solo dentro del contenido de un slot, el compilador no deja el binding
// disponible en esa clausura y lanza "Astro is not defined".
const nonce = Astro.locals.nonce;
---

<Base
  titulo="CarFlip — Autos usados en Chile con precio de mercado"
  descripcion="CarFlip reúne los autos usados en venta en Chile —de particulares y de automotoras— en un solo lugar, y detecta cuáles están publicados bajo su precio de mercado."
>

  <script is:inline nonce={nonce} slot="head" type="application/ld+json" set:html={scriptJsonLd(jsonLd)} />

  <!--
    Un solo módulo dominante: título, promesa y buscador. Las cifras cuelgan
    debajo como tira subordinada en vez de formar un segundo bloque del mismo
    peso. El fade de entrada se aplica acá, al bloque completo: una sola
    animación, sin escalonar (ver `.entrada` en global.css).
  -->
  <section class="entrada mb-section lg:mb-editorial">
    <p class="text-base text-ink/70 uppercase tracking-widest mb-element">Comparador de autos · Chile</p>
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-block text-balance max-w-4xl">
      Todos los autos en venta de Chile, en un solo lugar.
    </h1>
    <p class={`${parrafoCls} max-w-xl mb-block`}>
      No vendemos autos, te mostramos dónde están y cuánto cuestan.
    </p>

    <BuscadorHome disponibles={disponibles} />
    <Normalizacion />

    <div class="mt-element pt-element border-t border-line flex flex-wrap gap-x-block gap-y-element">
      <div>
        <p class="text-base text-ink/70">Avisos activos</p>
        <p id="avisos-activos" data-valor={estadisticas.total_avisos} class="text-4xl text-ink tabular-nums leading-none mt-1">
          {estadisticas.total_avisos.toLocaleString('es-CL')}
        </p>
      </div>
      {estadisticas.ultima_actualizacion && (
        <div>
          <p class="text-base text-ink/70">Actualizado</p>
          <p class="text-base text-ink tabular-nums">{formatearFecha(estadisticas.ultima_actualizacion)}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Deals destacados: banda en loop continuo. Se desacelera con suavidad al
       recibir cursor o foco, en vez de detenerse en seco (ver script abajo). -->
  {destacados.length > 0 && (
    <section>
      <div class="flex flex-wrap items-baseline justify-between gap-element mb-block">
        <h2 class="text-2xl text-ink">Deals destacados</h2>
        <a href="/deals" class="text-base text-ink hover:text-ink/70 transition-colors">
          Ver todos →
        </a>
      </div>

      <div
        id="deals-marquee"
        class="relative left-1/2 w-screen -ml-[50vw] overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]"
      >
        <div id="deals-marquee-track" class="flex gap-element w-max will-change-transform">
          <div id="deals-marquee-grupo" class="flex gap-element">
            {destacados.map((deal) => (
              <div class="w-[280px] sm:w-[320px] shrink-0"><CardDeal deal={deal} /></div>
            ))}
          </div>
          <div id="deals-marquee-duplicado" class="flex gap-element" inert>
            {destacados.map((deal) => (
              <div class="w-[280px] sm:w-[320px] shrink-0"><CardDeal deal={deal} /></div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

</Base>

<style>
  /* Sin JS o con animaciones reducidas: banda estática y navegable con scroll
     nativo en vez de loop infinito. El grupo duplicado no aporta nada aquí. */
  @media (prefers-reduced-motion: reduce) {
    #deals-marquee { overflow-x: auto; }
    #deals-marquee-track { transform: none !important; }
    #deals-marquee-duplicado { display: none; }
  }
</style>

<script>
  const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Conteo ascendente de "Avisos activos". El HTML llega con la cifra final
  // (SEO y sin JS); acá solo se anima el texto. El min-width se fija antes de
  // partir de cero para que la tira de cifras no se mueva al cambiar los dígitos.
  // El blur cae junto con la velocidad del conteo: se lee como desenfoque de
  // movimiento y la cifra queda nítida justo al asentarse.
  const contadorAvisos = document.getElementById('avisos-activos');
  const totalAvisos = Number(contadorAvisos?.dataset.valor);
  if (contadorAvisos && totalAvisos > 0 && !reducirMovimiento) {
    const DURACION = 1400; // ms
    const BLUR_MAX = 5;    // px
    contadorAvisos.style.minWidth = `${contadorAvisos.offsetWidth}px`;
    contadorAvisos.textContent = '0';
    let inicioConteo = 0;
    const contar = (ahora: number) => {
      if (!inicioConteo) inicioConteo = ahora;
      const avance = Math.min((ahora - inicioConteo) / DURACION, 1);
      contadorAvisos.textContent = Math.round(totalAvisos * (1 - (1 - avance) ** 3)).toLocaleString('es-CL');
      contadorAvisos.style.filter = avance < 1 ? `blur(${(BLUR_MAX * (1 - avance) ** 2).toFixed(2)}px)` : '';
      if (avance < 1) requestAnimationFrame(contar);
    };
    requestAnimationFrame(contar);
  }

  const contenedor = document.getElementById('deals-marquee');
  const pista = document.getElementById('deals-marquee-track');
  const grupo = document.getElementById('deals-marquee-grupo');

  if (contenedor && pista && grupo && !reducirMovimiento) {
    const VELOCIDAD_BASE = 40; // px/s
    const SUAVIZADO = 0.06;    // fracción de la brecha hacia la velocidad objetivo que se recorre por frame
    const GAP = 16;            // debe calzar con gap-element

    let posicion = 0;
    let velocidad = 0;
    let objetivo = VELOCIDAD_BASE;
    let anchoLoop = 0;
    let ultimoFrame = 0;
    let frameId: number | null = null;
    let visible = false;

    const medir = () => { anchoLoop = grupo.getBoundingClientRect().width + GAP; };

    const tick = (ahora: number) => {
      const dt = ultimoFrame ? Math.min((ahora - ultimoFrame) / 1000, 0.05) : 0;
      ultimoFrame = ahora;

      velocidad += (objetivo - velocidad) * SUAVIZADO;
      posicion -= velocidad * dt;
      if (anchoLoop && posicion <= -anchoLoop) posicion += anchoLoop;

      pista.style.transform = `translate3d(${posicion}px, 0, 0)`;
      frameId = requestAnimationFrame(tick);
    };

    const iniciar = () => {
      if (frameId === null) {
        ultimoFrame = 0;
        frameId = requestAnimationFrame(tick);
      }
    };
    const detener = () => {
      if (frameId !== null) {
        cancelAnimationFrame(frameId);
        frameId = null;
      }
    };
    const actualizarEstado = () => { if (visible && !document.hidden) iniciar(); else detener(); };

    medir();
    window.addEventListener('resize', medir);

    contenedor.addEventListener('pointerenter', () => { objetivo = 0; });
    contenedor.addEventListener('pointerleave', () => { objetivo = VELOCIDAD_BASE; });
    contenedor.addEventListener('focusin', () => { objetivo = 0; });
    contenedor.addEventListener('focusout', () => { objetivo = VELOCIDAD_BASE; });

    document.addEventListener('visibilitychange', actualizarEstado);
    new IntersectionObserver(([entrada]) => { visible = entrada.isIntersecting; actualizarEstado(); }).observe(contenedor);
  }
</script>
