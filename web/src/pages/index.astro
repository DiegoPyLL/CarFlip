---
import Base from '@layouts/Base.astro';
import CardAviso from '@components/avisos/CardAviso.astro';
import { obtenerAvisos, obtenerEstadisticas } from '@lib/db';
import { formatearPrecio, formatearFecha } from '@lib/formato';

// Antes `/` era el listado: los enlaces y backlinks con filtros siguen llegando
// aquí. Se preservan redirigiendo a /avisos con los mismos parámetros.
if (Astro.url.search) {
  return Astro.redirect('/avisos' + Astro.url.search, 301);
}

const [estadisticas, recientes] = await Promise.all([
  obtenerEstadisticas(),
  obtenerAvisos({ pagina: 1 }),
]);

const destacados = recientes.items.slice(0, 6);

const cifras = [
  {
    label: 'Precio promedio',
    valor: estadisticas.precio_promedio
      ? formatearPrecio(Math.round(estadisticas.precio_promedio))
      : '—',
  },
  { label: 'Autocosmos',  valor: estadisticas.total_autocosmos.toLocaleString('es-CL') },
  { label: 'Yapo',        valor: estadisticas.total_yapo.toLocaleString('es-CL') },
  { label: 'AutosUsados', valor: estadisticas.total_autosusados.toLocaleString('es-CL') },
  { label: 'Checkeados',  valor: estadisticas.total_checkeados.toLocaleString('es-CL') },
];

const secciones = [
  { href: '/avisos',        titulo: 'Avisos',        detalle: 'El listado completo, con filtros por marca, año, kilometraje y precio.' },
  { href: '/deals',         titulo: 'Deals',         detalle: 'Autos bajo el precio de mercado, evaluados por IA con puntaje y riesgos.' },
  { href: '/mercado',       titulo: 'Mercado',       detalle: 'Precios promedio, marcas y modelos más listados del país.' },
  { href: '/como-funciona', titulo: 'Cómo funciona', detalle: 'De dónde salen los datos y cómo se detectan las oportunidades.' },
];
---

<Base
  titulo="CarFlip — Compara precios de autos usados en Chile"
  descripcion="CarFlip reúne los avisos de autos usados de Autocosmos, Yapo, AutosUsados y Checkeados en un solo lugar, y detecta cuáles están publicados bajo su precio de mercado."
>

  <!-- Hero -->
  <section class="mb-section lg:mb-editorial">
    <p class="text-base text-muted uppercase tracking-widest mb-element">Comparador de autos · Chile</p>
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-block text-balance max-w-4xl">
      Todos los autos en venta de Chile, en un solo lugar.
    </h1>
    <p class="text-base text-muted leading-relaxed max-w-xl mb-block">
      CarFlip recopila a diario los avisos de los principales portales del país, los normaliza
      y detecta cuáles están publicados bajo su precio de mercado. No vendemos autos:
      te mostramos dónde están y cuánto cuestan.
    </p>
    <a
      href="/avisos"
      class="inline-flex items-center gap-2 text-base text-ink border border-ink px-6 py-3 hover:bg-ink hover:text-canvas transition-colors duration-150"
    >
      <span class="w-1.5 h-1.5 bg-scarlet-signal shrink-0" aria-hidden="true"></span>
      Ver los {estadisticas.total_avisos.toLocaleString('es-CL')} avisos
    </a>
  </section>

  <!-- Cifra de portada: el número manda, el resto son pares label/valor -->
  <section class="mb-section lg:mb-editorial">
    <p class="text-5xl sm:text-7xl text-ink tabular-nums leading-none">
      {estadisticas.total_avisos.toLocaleString('es-CL')}
    </p>
    <p class="text-base text-muted mt-2">avisos activos en seguimiento</p>

    <div class="flex flex-wrap gap-x-block gap-y-element mt-block">
      {cifras.map(({ label, valor }) => (
        <div>
          <p class="text-base text-muted">{label}</p>
          <p class="text-base text-ink tabular-nums">{valor}</p>
        </div>
      ))}
      {estadisticas.ultima_actualizacion && (
        <div>
          <p class="text-base text-muted">Actualizado</p>
          <p class="text-base text-ink">{formatearFecha(estadisticas.ultima_actualizacion)}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Últimos avisos -->
  {destacados.length > 0 && (
    <section class="mb-section lg:mb-editorial">
      <div class="flex flex-wrap items-baseline justify-between gap-element mb-block">
        <h2 class="text-2xl text-ink">Últimos avisos publicados</h2>
        <a href="/avisos" class="text-base text-ink hover:text-muted transition-colors">
          Ver todos →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-element">
        {destacados.map((aviso) => <CardAviso aviso={aviso} />)}
      </div>
    </section>
  )}

  <!-- Secciones: lista apilada, sin cajas -->
  <section>
    <h2 class="text-base text-muted uppercase tracking-widest mb-block">Explorar</h2>
    <ul class="divide-y divide-line border-y border-line">
      {secciones.map(({ href, titulo, detalle }) => (
        <li>
          <a href={href} class="group flex flex-wrap items-baseline gap-x-element gap-y-1 py-block hover:bg-surface transition-colors">
            <span class="text-2xl text-ink w-40 shrink-0">{titulo}</span>
            <span class="text-base text-muted flex-1 min-w-0">{detalle}</span>
            <span class="text-base text-ink shrink-0" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

</Base>
