---
import Base from '@layouts/Base.astro';
import CardDeal from '@components/deals/CardDeal.astro';
import { obtenerDeals, obtenerEstadisticas } from '@lib/db';
import { formatearPrecio, formatearFecha } from '@lib/formato';
import { parrafoCls } from '@lib/marketing';

// Antes `/` era el listado: los enlaces y backlinks con filtros siguen llegando
// aquí. Se preservan redirigiendo a /avisos con los mismos parámetros.
if (Astro.url.search) {
  return Astro.redirect('/avisos' + Astro.url.search, 301);
}

const [estadisticas, destacados] = await Promise.all([
  obtenerEstadisticas(),
  obtenerDeals(undefined, undefined, 10),
]);

const cifras = [
  {
    label: 'Precio promedio',
    valor: estadisticas.precio_promedio
      ? formatearPrecio(Math.round(estadisticas.precio_promedio))
      : '—',
  },
  { label: 'Autocosmos',  valor: estadisticas.total_autocosmos.toLocaleString('es-CL') },
  { label: 'Yapo',        valor: estadisticas.total_yapo.toLocaleString('es-CL') },
  { label: 'AutosUsados', valor: estadisticas.total_autosusados.toLocaleString('es-CL') },
  { label: 'Checkeados',  valor: estadisticas.total_checkeados.toLocaleString('es-CL') },
];
---

<Base
  titulo="CarFlip — Compara precios de autos usados en Chile"
  descripcion="CarFlip reúne los avisos de autos usados de Autocosmos, Yapo, AutosUsados y Checkeados en un solo lugar, y detecta cuáles están publicados bajo su precio de mercado."
>

  <!-- Hero -->
  <section class="mb-section lg:mb-editorial">
    <p class="text-base  uppercase tracking-widest mb-element">Comparador de autos · Chile</p>
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-block text-balance max-w-4xl">
      Todos los autos en venta de Chile, en un solo lugar.
    </h1>
    <p class={`${parrafoCls} max-w-xl mb-block`}>
      CarFlip recopila a diario los avisos de los principales portales del país, los normaliza
      y detecta cuáles están publicados bajo su precio de mercado. No vendemos autos:
      te mostramos dónde están y cuánto cuestan.
    </p>
  </section>

  <!-- Cifra de portada: el número manda, el resto son pares label/valor -->
  <section class="mb-section lg:mb-editorial">
    <p class="text-5xl sm:text-7xl text-ink tabular-nums leading-none">
      {estadisticas.total_avisos.toLocaleString('es-CL')}
    </p>
    <p class="text-base  mt-2">avisos activos en seguimiento</p>

    <div class="flex flex-wrap gap-x-block gap-y-element mt-block">
      {cifras.map(({ label, valor }) => (
        <div>
          <p class="text-base ">{label}</p>
          <p class="text-base text-ink tabular-nums">{valor}</p>
        </div>
      ))}
      {estadisticas.ultima_actualizacion && (
        <div>
          <p class="text-base ">Actualizado</p>
          <p class="text-base text-ink">{formatearFecha(estadisticas.ultima_actualizacion)}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Deals destacados: banda en loop continuo. Se desacelera con suavidad al
       recibir cursor o foco, en vez de detenerse en seco (ver script abajo). -->
  {destacados.length > 0 && (
    <section>
      <div class="flex flex-wrap items-baseline justify-between gap-element mb-block">
        <h2 class="text-2xl text-ink">Deals destacados</h2>
        <a href="/deals" class="text-base text-ink hover: transition-colors">
          Ver todos →
        </a>
      </div>

      <div
        id="deals-marquee"
        class="relative left-1/2 w-screen -ml-[50vw] overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]"
      >
        <div id="deals-marquee-track" class="flex gap-element w-max will-change-transform">
          <div id="deals-marquee-grupo" class="flex gap-element">
            {destacados.map((deal) => (
              <div class="w-[280px] sm:w-[320px] shrink-0"><CardDeal deal={deal} /></div>
            ))}
          </div>
          <div id="deals-marquee-duplicado" class="flex gap-element" inert>
            {destacados.map((deal) => (
              <div class="w-[280px] sm:w-[320px] shrink-0"><CardDeal deal={deal} /></div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

</Base>

<style>
  /* Sin JS o con animaciones reducidas: banda estática y navegable con scroll
     nativo en vez de loop infinito. El grupo duplicado no aporta nada aquí. */
  @media (prefers-reduced-motion: reduce) {
    #deals-marquee { overflow-x: auto; }
    #deals-marquee-track { transform: none !important; }
    #deals-marquee-duplicado { display: none; }
  }
</style>

<script>
  const contenedor = document.getElementById('deals-marquee');
  const pista = document.getElementById('deals-marquee-track');
  const grupo = document.getElementById('deals-marquee-grupo');

  if (contenedor && pista && grupo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const VELOCIDAD_BASE = 40; // px/s
    const SUAVIZADO = 0.06;    // fracción de la brecha hacia la velocidad objetivo que se recorre por frame
    const GAP = 16;            // debe calzar con gap-element

    let posicion = 0;
    let velocidad = 0;
    let objetivo = VELOCIDAD_BASE;
    let anchoLoop = 0;
    let ultimoFrame = 0;
    let frameId: number | null = null;
    let visible = false;

    const medir = () => { anchoLoop = grupo.getBoundingClientRect().width + GAP; };

    const tick = (ahora: number) => {
      const dt = ultimoFrame ? Math.min((ahora - ultimoFrame) / 1000, 0.05) : 0;
      ultimoFrame = ahora;

      velocidad += (objetivo - velocidad) * SUAVIZADO;
      posicion -= velocidad * dt;
      if (anchoLoop && posicion <= -anchoLoop) posicion += anchoLoop;

      pista.style.transform = `translate3d(${posicion}px, 0, 0)`;
      frameId = requestAnimationFrame(tick);
    };

    const iniciar = () => {
      if (frameId === null) {
        ultimoFrame = 0;
        frameId = requestAnimationFrame(tick);
      }
    };
    const detener = () => {
      if (frameId !== null) {
        cancelAnimationFrame(frameId);
        frameId = null;
      }
    };
    const actualizarEstado = () => { if (visible && !document.hidden) iniciar(); else detener(); };

    medir();
    window.addEventListener('resize', medir);

    contenedor.addEventListener('pointerenter', () => { objetivo = 0; });
    contenedor.addEventListener('pointerleave', () => { objetivo = VELOCIDAD_BASE; });
    contenedor.addEventListener('focusin', () => { objetivo = 0; });
    contenedor.addEventListener('focusout', () => { objetivo = VELOCIDAD_BASE; });

    document.addEventListener('visibilitychange', actualizarEstado);
    new IntersectionObserver(([entrada]) => { visible = entrada.isIntersecting; actualizarEstado(); }).observe(contenedor);
  }
</script>
