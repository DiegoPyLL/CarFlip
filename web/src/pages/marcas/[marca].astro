---
import Base from '@layouts/Base.astro';
import CardAviso from '@components/avisos/CardAviso.astro';
import { obtenerAvisos } from '@lib/db/avisos';
import { obtenerDatosMarca } from '@lib/db/mercado';
import { formatearPrecio } from '@lib/formato';

const { marca } = Astro.params;

if (!marca) return Astro.redirect('/mercado');

const marcaDecoded = decodeURIComponent(marca);

// Cargamos en paralelo: stats de la marca + primeros avisos
const [datos, resultado] = await Promise.all([
  obtenerDatosMarca(marcaDecoded),
  obtenerAvisos({ marca: marcaDecoded, pagina: 1 }),
]);

if (datos.total === 0) return Astro.redirect('/mercado');

const maxModelo = datos.modelos[0]?.total ?? 1;
const maxAnio   = datos.anios[0]?.total ?? 1;
const maxDist   = Math.max(...datos.distribucion.map(d => d.total), 1);

// Mismas clases compartidas que /mercado: el borde hairline es toda la estructura.
const panelCls    = 'bg-surface border border-line';
const cabeceraCls = 'p-element border-b border-line';
const filaCls     = 'flex items-center gap-element p-element hover:bg-canvas transition-colors';
// `w-full overflow-hidden` es necesario: sin ancho explícito, el % de la barra
// interior queda indeterminado durante el sizing intrínseco y dispara el layout.
const pistaCls    = 'h-px w-full bg-line overflow-hidden';
const enlaceCls   = 'text-base text-ink hover: transition-colors';
---

<Base
  titulo={`${marcaDecoded} en Chile — Precios y avisos`}
  descripcion={`${datos.total} avisos de ${marcaDecoded} en Chile. Precio promedio ${formatearPrecio(datos.precio_promedio ? Math.round(datos.precio_promedio) : null)}. Compara modelos, años y precios.`}
>

  <!-- Breadcrumb -->
  <nav class="text-base  mb-block flex items-center gap-2">
    <a href="/avisos" class="hover:text-ink transition-colors">Avisos</a>
    <span aria-hidden="true">/</span>
    <a href="/mercado" class="hover:text-ink transition-colors">Mercado</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink">{marcaDecoded}</span>
  </nav>

  <!-- Header -->
  <div class="mb-section">
    <p class="text-base  uppercase tracking-widest mb-element">Marca</p>
    <h1 class="text-5xl sm:text-7xl text-ink leading-none mb-block">{marcaDecoded}</h1>

    <!-- Stats: pares label/valor apilados -->
    <div class="flex flex-wrap gap-x-block gap-y-element">
      <div>
        <p class="text-base ">Avisos activos</p>
        <p class="text-base text-ink tabular-nums">{datos.total.toLocaleString('es-CL')}</p>
      </div>
      {datos.precio_promedio && (
        <div>
          <p class="text-base ">Precio promedio</p>
          <p class="text-base text-ink tabular-nums">
            {formatearPrecio(Math.round(datos.precio_promedio))}
          </p>
        </div>
      )}
      {datos.precio_minimo && datos.precio_maximo && (
        <div>
          <p class="text-base ">Rango publicado</p>
          <p class="text-base text-ink tabular-nums">
            {formatearPrecio(Math.round(datos.precio_minimo))} — {formatearPrecio(Math.round(datos.precio_maximo))}
          </p>
        </div>
      )}
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-element mb-section">

    <!-- Columna principal: modelos + años -->
    <div class="space-y-element">

      <!-- Modelos más listados -->
      <section class={panelCls}>
        <div class={cabeceraCls}>
          <h2 class="text-base text-ink">Modelos más listados</h2>
          <p class="text-base ">Top {datos.modelos.length} por cantidad de avisos</p>
        </div>
        <div class="divide-y divide-line">
          {datos.modelos.map((m, i) => (
            <div class={filaCls}>
              <span class="text-base  w-6 shrink-0 tabular-nums text-right">
                {i + 1}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-2">
                  <a
                    href={`/avisos?marca=${encodeURIComponent(marcaDecoded)}&modelo=${encodeURIComponent(m.modelo)}`}
                    class={`${enlaceCls} truncate`}
                  >
                    {m.modelo}
                  </a>
                  <span class="text-base  tabular-nums ml-3 shrink-0">
                    {m.total.toLocaleString('es-CL')}
                  </span>
                </div>
                <div class={pistaCls}>
                  <div
                    class="h-full bg-ink"
                    style={`width: ${(m.total / maxModelo * 100).toFixed(1)}%`}
                  />
                </div>
              </div>
              <span class="text-base tabular-nums  w-28 text-right shrink-0 hidden sm:block">
                {m.precio_promedio ? formatearPrecio(Math.round(m.precio_promedio)) : '—'}
              </span>
            </div>
          ))}
        </div>
        <!-- CTA ver todos -->
        <div class="p-element border-t border-line">
          <a
            href={`/avisos?marca=${encodeURIComponent(marcaDecoded)}`}
            class={enlaceCls}
          >
            Ver todos los {datos.total.toLocaleString('es-CL')} avisos de {marcaDecoded} →
          </a>
        </div>
      </section>

      <!-- Distribución por año -->
      {datos.anios.length > 0 && (
        <section class={panelCls}>
          <div class={cabeceraCls}>
            <h2 class="text-base text-ink">Avisos por año</h2>
            <p class="text-base ">Últimos {datos.anios.length} años con stock</p>
          </div>
          <div class="divide-y divide-line">
            {datos.anios.map(a => (
              <div class={filaCls}>
                <a
                  href={`/avisos?marca=${encodeURIComponent(marcaDecoded)}&anio=${a.anio}`}
                  class={`${enlaceCls} w-12 shrink-0 tabular-nums`}
                >
                  {a.anio}
                </a>
                <div class="flex-1 min-w-0">
                  <div class={pistaCls}>
                    <div
                      class="h-full bg-muted"
                      style={`width: ${(a.total / maxAnio * 100).toFixed(1)}%`}
                    />
                  </div>
                </div>
                <span class="text-base  tabular-nums w-10 text-right shrink-0">
                  {a.total}
                </span>
                <span class="text-base tabular-nums  w-28 text-right shrink-0 hidden sm:block">
                  {a.precio_promedio ? formatearPrecio(Math.round(a.precio_promedio)) : '—'}
                </span>
              </div>
            ))}
          </div>
        </section>
      )}

    </div>

    <!-- Columna lateral: distribución de precios -->
    <div class="space-y-element">
      <section class={panelCls}>
        <div class={cabeceraCls}>
          <h2 class="text-base text-ink">Distribución de precios</h2>
          <p class="text-base ">Avisos por rango</p>
        </div>
        <div class="p-element space-y-element">
          {datos.distribucion.map(d => (
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-base text-ink">{d.etiqueta}</span>
                <span class="text-base tabular-nums ">
                  {d.total.toLocaleString('es-CL')}
                </span>
              </div>
              <div class={pistaCls}>
                <div
                  class="h-full bg-ink"
                  style={`width: ${d.total > 0 ? (d.total / maxDist * 100).toFixed(1) : 0}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Links a otras marcas del mercado -->
      <div class={`${panelCls} p-element`}>
        <p class="text-sm  uppercase tracking-wider mb-element">Explorar</p>
        <div class="flex flex-col gap-2">
          <a
            href={`/avisos?marca=${encodeURIComponent(marcaDecoded)}`}
            class={`${enlaceCls} flex items-center justify-between py-1`}
          >
            <span>Todos los {marcaDecoded}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/mercado" class={`${enlaceCls} flex items-center justify-between py-1`}>
            <span>Todas las marcas</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/deals" class={`${enlaceCls} flex items-center justify-between py-1`}>
            <span>Deals activos</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Últimos avisos -->
  {resultado.items.length > 0 && (
    <section>
      <div class="flex flex-wrap items-center justify-between gap-element mb-element">
        <h2 class="text-2xl text-ink">
          Últimos avisos de {marcaDecoded}
        </h2>
        <a
          href={`/avisos?marca=${encodeURIComponent(marcaDecoded)}`}
          class={enlaceCls}
        >
          Ver todos →
        </a>
      </div>
      <div
        id="avisos-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-element"
      >
        {resultado.items.slice(0, 8).map((aviso) => (
          <CardAviso aviso={aviso} />
        ))}
      </div>
    </section>
  )}

</Base>
