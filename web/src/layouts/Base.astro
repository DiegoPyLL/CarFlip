---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
  urlCanonica?: string;
  urlImagen?: string;
  tipo?: string;
  noindex?: boolean;
}

const {
  titulo,
  descripcion = 'CarFlip — Encuentra oportunidades de autos en Chile. Comparamos precios de Autocosmos y Yapo en tiempo real.',
  urlCanonica = Astro.url.href,
  urlImagen = '/og-default.png',
  tipo = 'website',
  noindex = false,
} = Astro.props;

const tituloCompleto = titulo.endsWith('CarFlip') ? titulo : `${titulo} — CarFlip`;

// El origen canónico sale de `site` en astro.config.mjs (carflip.cl), no del host
// de la request: así los deploys de preview (*.vercel.app) siguen apuntando al
// dominio productivo en canonical y Open Graph.
const origenCanonico = Astro.site?.origin ?? Astro.url.origin;
const rutaCanonica = new URL(urlCanonica, Astro.url.origin);
const urlCanonicaAbs = new URL(rutaCanonica.pathname + rutaCanonica.search, origenCanonico).href;
// Las imágenes del CDN ya vienen absolutas; solo se resuelven las rutas locales.
const urlImagenAbs = new URL(urlImagen, origenCanonico).href;

// Bajo md: la nav entera se pliega en el menú desplegable, así que ningún
// enlace se oculta por falta de ancho: los seis están siempre alcanzables.
const enlaceSesion = Astro.locals.usuario
  ? { href: '/cuenta', texto: 'Mi cuenta' }
  : { href: '/entrar', texto: 'Entrar' };

const enlacesNav = [
  { href: '/',              texto: 'Home' },
  { href: '/avisos',        texto: 'Avisos' },
  { href: '/deals',         texto: 'Deals' },
  { href: '/mercado',       texto: 'Mercado' },
  { href: '/como-funciona', texto: 'Cómo funciona' },
  enlaceSesion,
];

// `/` solo marca activo en coincidencia exacta; el resto también en sus subrutas
// (así /marcas/Kia resalta Mercado y /auto/814 resalta Avisos).
const rutaActual = Astro.url.pathname.replace(/\/+$/, '') || '/';
const prefijosPorSeccion: Record<string, string[]> = {
  '/avisos': ['/auto'],
  '/mercado': ['/marcas'],
  '/cuenta': ['/cuenta'],
};
function esRutaActiva(href: string): boolean {
  if (href === '/') return rutaActual === '/';
  if (rutaActual === href) return true;
  return (prefijosPorSeccion[href] ?? []).some((p) => rutaActual.startsWith(p));
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <!--
      Bloqueante y en <head> a propósito: aplica el tema guardado antes del
      primer pintado. Diferirlo provocaría un flash del tema equivocado.
      El claro es el principal, así que solo se marca el documento si hay
      preferencia explícita por el oscuro.
    -->
    <script is:inline nonce={Astro.locals.nonce}>
      try {
        if (localStorage.getItem('tema') === 'oscuro') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch (_) {}
    </script>

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlCanonicaAbs} />

    <!-- Open Graph -->
    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={urlCanonicaAbs} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={urlImagenAbs} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="CarFlip" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagenAbs} />

    <slot name="head" />
  </head>
  <body class="bg-canvas text-ink min-h-screen flex flex-col antialiased">
    <!-- La barra se funde con el canvas: sin borde ni blur. El <header> reserva
         en el flujo los 80px del estado expandido y la barra va `fixed`, así el
         encogimiento al hacer scroll no empuja el contenido y no hay layout
         shift. Los estados (compacta, oculta, menú abierto) son atributos sobre
         #barra y se dibujan en global.css; los conmuta el script del final. -->
    <header class="h-20 shrink-0">
      <div id="barra" class="fixed inset-x-0 top-0 z-20 bg-canvas">
        <div id="barra-fila" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
          <a href="/" class="flex items-baseline gap-4 shrink-0">
            <span id="barra-marca" class="font-normal text-ink">CarFlip</span>
            <span class="hidden lg:block text-base text-ink/70">Comparador de autos Chile</span>
          </a>

          <div class="flex items-center gap-3 sm:gap-4">
            <!-- Una sola nav para ambos anchos: bajo md: se despliega bajo la
                 barra, de ahí para arriba va en línea. -->
            <nav
              id="menu"
              aria-label="Navegación principal"
              class="absolute inset-x-0 top-full bg-canvas border-y border-line px-4 sm:px-6 md:static md:border-0 md:px-0"
            >
              <ul class="max-w-7xl mx-auto text-base divide-y divide-line md:flex md:gap-4 md:divide-y-0">
                {enlacesNav.map(({ href, texto }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={esRutaActiva(href) ? 'page' : undefined}
                      class:list={[
                        'block py-3 md:py-0',
                        esRutaActiva(href)
                          ? 'text-ink underline underline-offset-4'
                          : 'text-ink/70 hover:text-ink transition-colors duration-200',
                      ]}
                    >
                      {texto}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <!-- Toggle de tema. El claro es el principal; se guarda la elección. -->
            <button
              type="button"
              id="tema-toggle"
              class="shrink-0 md:-mr-2 h-10 w-10 flex items-center justify-center hover:opacity-70 transition-opacity cursor-pointer"
              aria-label="Cambiar a tema oscuro"
            >
              <svg class="text-sun-line dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" class="fill-sun-signal"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
              <svg class="hidden text-moon-signal dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </button>

            <!-- Hamburguesa: solo bajo md:, donde la nav vive plegada. Los dos
                 glifos se alternan según `aria-expanded`, sin atributo extra. -->
            <button
              type="button"
              id="menu-boton"
              class="md:hidden shrink-0 -mr-2 h-10 w-10 flex items-center justify-center hover:opacity-70 transition-opacity cursor-pointer"
              aria-label="Abrir menú"
              aria-expanded="false"
              aria-controls="menu"
            >
              <svg class="icono-abrir" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M3 6h18M3 12h18M3 18h18"/>
              </svg>
              <svg class="icono-cerrar" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 lg:py-block">
      <slot />
    </main>

    <!-- Único bloque del sitio con el acento blue-signal: identifica el footer
         como bloque de marca, no de producto. Todo el texto usa ink-on-tint
         (blanco fijo), no ink, que en tema claro sería negro y perdería
         contraste sobre este azul. -->
    <footer class="mt-section bg-blue-signal">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-block">
        <div class="flex flex-col gap-block lg:flex-row lg:justify-between">
          <div class="max-w-sm">
            <span class="text-2xl font-semibold text-ink-on-tint">CarFlip</span>
            <p class="text-sm text-ink-on-tint leading-relaxed mt-2">
              Comparador de autos usados en Chile. Un proyecto sin fines de lucro que reúne
              los avisos de los principales portales para que compares precios en un solo lugar.
            </p>
            <a
              href="/quienes-somos"
              class="inline-flex text-base text-ink-on-tint underline underline-offset-4 mt-element"
            >
              Quiénes somos →
            </a>
          </div>

          <div class="flex flex-wrap gap-block">
            <nav aria-label="Producto">
              <h2 class="text-sm font-semibold text-ink-on-tint uppercase tracking-widest mb-element">Producto</h2>
              <ul class="space-y-2">
                <li><a href="/avisos" class="text-base text-ink-on-tint hover:underline underline-offset-4">Avisos</a></li>
                <li><a href="/deals" class="text-base text-ink-on-tint hover:underline underline-offset-4">Deals</a></li>
                <li><a href="/mercado" class="text-base text-ink-on-tint hover:underline underline-offset-4">Mercado</a></li>
                <li>
                  <a href={enlaceSesion.href} rel="nofollow" class="text-base text-ink-on-tint hover:underline underline-offset-4">
                    {enlaceSesion.texto}
                  </a>
                </li>
              </ul>
            </nav>

            <nav aria-label="Compañía">
              <h2 class="text-sm font-semibold text-ink-on-tint uppercase tracking-widest mb-element">Compañía</h2>
              <ul class="space-y-2">
                <li><a href="/como-funciona#preguntas-frecuentes" class="text-base text-ink-on-tint hover:underline underline-offset-4">Preguntas Frecuentes</a></li>
                <li><a href="/contacto" class="text-base text-ink-on-tint hover:underline underline-offset-4">Contáctanos</a></li>
                <li>
                  <a
                    href="https://github.com/VolutusDevGroup"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-base text-ink-on-tint hover:underline underline-offset-4">Github</a></li>
                <li>
                  <a
                    href="https://volutus.cl"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-base text-ink-on-tint hover:underline underline-offset-4">Volutus</a></li>
              </ul>
            </nav>

            <nav aria-label="Legal">
              <h2 class="text-sm font-semibold text-ink-on-tint uppercase tracking-widest mb-element">Legal</h2>
              <ul class="space-y-2">
                <li><a href="/condiciones-de-uso" class="text-base text-ink-on-tint hover:underline underline-offset-4">Condiciones de Uso</a></li>
                <li><a href="/privacidad" class="text-base text-ink-on-tint hover:underline underline-offset-4">Términos de privacidad</a></li>
                <li><a href="/legal" class="text-base text-ink-on-tint hover:underline underline-offset-4">Legales</a></li>
              </ul>
            </nav>
          </div>
        </div>

        <div class="mt-block pt-element border-t border-ink-on-tint/15 flex flex-wrap gap-2 items-center justify-between">
          <span class="text-sm text-ink-on-tint">&copy; {new Date().getFullYear()} CarFlip. Todos los derechos reservados.</span>
        </div>
      </div>
    </footer>

    <script is:inline nonce={Astro.locals.nonce}>
      (() => {
        const barra = document.getElementById('barra');
        const boton = document.getElementById('menu-boton');
        if (!barra || !boton) return;

        // El panel precede al botón en el DOM, así que al abrirlo el foco se
        // lleva a su primer enlace: si no, un Tab desde la hamburguesa saltaría
        // por sobre el menú recién desplegado. Escape lo devuelve al botón.
        const abrirMenu = (abierto) => {
          barra.toggleAttribute('data-menu', abierto);
          boton.setAttribute('aria-expanded', String(abierto));
          boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
          if (abierto) document.querySelector('#menu a')?.focus();
        };

        boton.addEventListener('click', () => abrirMenu(!barra.hasAttribute('data-menu')));

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && barra.hasAttribute('data-menu')) {
            abrirMenu(false);
            boton.focus();
          }
        });

        document.addEventListener('click', (e) => {
          if (barra.hasAttribute('data-menu') && !barra.contains(e.target)) abrirMenu(false);
        });

        // Pasando a escritorio la nav vuelve a la barra, así que el estado del
        // desplegable se limpia: si quedara puesto, bloquearía el retraerse.
        matchMedia('(width >= 48rem)').addEventListener('change', (e) => {
          if (e.matches) abrirMenu(false);
        });

        // Listener pasivo y un solo rAF por frame: el scroll nunca se bloquea.
        const RECORRIDO = 80; // en cuántos px de scroll la barra termina de encoger
        const UMBRAL = 24;    // cuánto hay que recorrer en un sentido para conmutar
        const PISO = 160;     // desde dónde puede empezar a retraerse

        let ultimo = window.scrollY;
        let ancla = ultimo;
        let bajando = false;
        let pendiente = false;

        const medir = () => {
          pendiente = false;
          const y = Math.max(0, window.scrollY);

          // El encogimiento es continuo: `--p` mapea el scroll a un 0…1 y el
          // CSS interpola alto y wordmark. Sin transición de por medio, así que
          // la barra sigue al scroll en vez de animar por su cuenta.
          barra.style.setProperty('--p', Math.min(y / RECORRIDO, 1).toFixed(3));

          if (y === ultimo) return;

          // El momentum y el rebote del trackpad invierten el sentido por uno o
          // dos píxeles. Sin histéresis eso conmuta la barra en cada micro-
          // cambio y se ve como un parpadeo. El ancla se reubica al cambiar de
          // sentido y recién se conmuta tras recorrer UMBRAL en el nuevo.
          const bajandoAhora = y > ultimo;
          if (bajandoAhora !== bajando) {
            bajando = bajandoAhora;
            ancla = ultimo;
          }
          ultimo = y;

          if (Math.abs(y - ancla) > UMBRAL) {
            barra.toggleAttribute(
              'data-oculta',
              bajando && y > PISO && !barra.hasAttribute('data-menu'),
            );
          }
        };
        medir();
        addEventListener('scroll', () => {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(medir);
        }, { passive: true });
      })();
    </script>

    <script is:inline nonce={Astro.locals.nonce}>
      (() => {
        const raiz = document.documentElement;
        const boton = document.getElementById('tema-toggle');
        const rotular = () => {
          const oscuro = raiz.dataset.theme === 'dark';
          boton?.setAttribute('aria-label', oscuro ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
        };
        rotular();
        boton?.addEventListener('click', () => {
          const oscuro = raiz.dataset.theme === 'dark';
          if (oscuro) delete raiz.dataset.theme;
          else raiz.dataset.theme = 'dark';
          try { localStorage.setItem('tema', oscuro ? 'claro' : 'oscuro'); } catch (_) {}
          rotular();
        });
      })();
    </script>

    <Analytics />
  </body>
</html>
