---
import Base from '@layouts/Base.astro';

interface Props {
  codigo: number;
  titulo: string;
  descripcion: string;
  encabezado: string;
  accion: { href: string; texto: string };
}

const { codigo, titulo, descripcion, encabezado, accion } = Astro.props;

// Una página renderizada responde 200 por defecto, así que el estado se fija a
// mano: sin esto un aviso despublicado diría "no encontrado" con estado de
// éxito y los rastreadores lo indexarían como contenido válido.
Astro.response.status = codigo;
---

<Base titulo={titulo} descripcion={descripcion} noindex>
  <div class="max-w-2xl py-block">
    <p class="text-base mb-element tabular-nums">Error {codigo}</p>
    <h1 id="pe-encabezado" class="text-5xl sm:text-7xl text-ink leading-none text-balance mb-element">
      {encabezado}
    </h1>
    <p id="pe-detalle" class="text-base leading-relaxed mb-block" aria-live="polite"><slot /></p>
    <a
      id="pe-accion"
      href={accion.href}
      class="inline-flex items-center gap-2 text-base text-ink border border-ink px-6 py-3 hover:bg-ink hover:text-canvas transition-colors duration-150"
    >
      <span class="w-1.5 h-1.5 bg-scarlet-signal" aria-hidden="true"></span>
      <span id="pe-accion-texto">{accion.texto}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</Base>
